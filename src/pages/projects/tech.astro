---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

// Employment history. `order` drives the sequence rather than the dates, so it
// can be adjusted without rewriting frontmatter.
const allExperience = (await getCollection('experience'))
  .sort((a, b) => a.data.order - b.data.order);

// Two tiers on purpose. Roles with something to show get a card and a case page;
// roles with a real result but nothing showable get a single line, so the
// section isn't padded out to an even five.
const experience = allExperience.filter((e) => !e.data.compact);
const compactExperience = allExperience.filter((e) => e.data.compact);

// The grid reads the content collection. It used to be a hardcoded array here,
// which meant two sources of truth for the same four projects. Edit the MDX and
// the grid went stale. `listed: false` is how a project keeps its page without
// appearing here.
const projects = (await getCollection('projects'))
  .filter((p) => p.data.listed !== false)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({
    title: p.data.title,
    subtitle: p.data.subtitle ?? '',
    desc: p.data.description,
    tags: p.data.tags,
    status: p.data.live_url ? 'Live' : String(p.data.date.getUTCFullYear()),
    link: `/projects/${p.id.replace(/\.mdx?$/, '')}`,
  }));
---

<MainLayout title="Work · Karen Dettmar" theme="dark">

  <style>
    .tech-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 120px 48px 100px;
    }

    /* No bottom rule here, since the sticky section nav sits directly beneath and
       carries one of its own, and two hairlines that close together read as a
       mistake. */
    .page-header {
      margin-bottom: 0;
      padding-bottom: 26px;
    }
    /* Title and search on one line, sharing a baseline. They stack, search
       first-under, once there isn't room for both. */
    .page-header-top {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: clamp(24px, 4vw, 56px);
      flex-wrap: wrap;
    }
    /* The shared .page-title carries its own rule and 56px of margin, which
       works when it's a full-width block. As a flex item it shrinks to the
       word, leaving a stub of a rule under "Work", and the section nav below
       already draws the real one. */
    .page-header-top .page-title {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
    /* Everything else (family, weight, line-height, opsz, the `em` color)
       comes from the canonical .page-title in global.css. This page differs
       only in the title's ceiling and how tight it sets. */
    .page-title {
      font-size: clamp(44px, 6vw, 80px);
      letter-spacing: -0.04em;
    }

    /* grid */
    .project-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    /* Cards follow the landing page: hairline rules, display type with no
       italic, monospace for every piece of metadata, oxblood on hover. */
    .project-card {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 34px 32px 30px;
      border: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      transition: border-color 0.35s ease, background 0.35s ease, transform 0.35s cubic-bezier(0.2,0.8,0.3,1);
    }
    .project-card::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--sienna);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.45s cubic-bezier(0.2,0.8,0.3,1);
    }
    .project-card:hover {
      border-color: var(--sienna);
      background: var(--warm-white);
      transform: translateY(-3px);
    }
    .project-card:hover::before { transform: scaleY(1); }
    .project-card:focus-visible {
      outline: 2px solid var(--sienna);
      outline-offset: 4px;
    }

    /* ── FILTERS ──
       Sits on the title's line. Allowed to shrink well below its 420px ideal
       before the row gives up and wraps. */
    .filters {
      margin: 0;
      flex: 0 1 420px;
      min-width: 230px;
    }
    .filter-search {
      position: relative;
      display: block;
      width: 100%;
    }
    .filter-search input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--border);
      padding: 10px 30px 10px 0;
      font-family: var(--font-body);
      font-size: var(--fs-400);
      color: var(--black);
      transition: border-color 0.25s ease;
    }
    .filter-search input::placeholder { color: var(--muted); }
    .filter-search input:focus {
      outline: none;
      border-bottom-color: var(--sienna);
    }
    .filter-search input:focus-visible { outline: none; }
    .filter-clear {
      position: absolute;
      right: 0; top: 50%; transform: translateY(-50%);
      background: none; border: none; padding: 4px;
      color: var(--muted); line-height: 1;
      font-size: var(--fs-450); display: none;
    }
    .filter-clear:hover { color: var(--black); }
    .filter-clear.on { display: block; }

    .filter-count {
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: var(--track-meta);
      text-transform: uppercase;
      color: var(--muted);
      margin-top: 14px;
    }
    /* It's a live region, so it stays in the DOM to be announced, but with
       nothing to say it shouldn't hold space open under the field. */
    .filter-count:empty { display: none; }
    /* Anything the search can filter has to collapse when hidden, and several of
       these set their own display, which would otherwise beat [hidden]. */
    .project-card[hidden],
    .xp-card[hidden],
    .exp-item[hidden],
    .xp-compact li[hidden],
    .work-section[hidden],
    .experiments[hidden],
    .xp[hidden] { display: none; }

    .no-results {
      padding: var(--space-7) 0;
      font-size: var(--fs-400);
      color: var(--muted);
    }

    /* ── SECTION NAV ──
       Sticks directly beneath the site header, which is fixed and opaque, so
       it has to know that header's height; --header-h is measured at runtime
       and the fallback matches the header's resting size. One line of type and
       a hairline is the whole budget. */
    .section-nav {
      position: sticky;
      /* A pixel of overlap rather than an exact meeting. Even with a fractional
         measurement, the browser rounds the sticky position and the header's
         painted edge independently, and any disagreement shows as a hairline of
         moving page between them. The header is fixed at z-index 100 and opaque,
         so it simply paints over this pixel. */
      top: calc(var(--header-h, 68px) - 1px);
      z-index: 60;
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      margin-bottom: 44px;
      padding: 11px 0;
      background: var(--off-white);
      border-bottom: 1px solid var(--border);
      transition: background-color 0.35s ease;
    }
    .section-nav a {
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
      padding-bottom: 3px;
      border-bottom: 1px solid transparent;
      transition: color 0.25s ease, border-color 0.25s ease;
    }
    .section-nav a:hover { color: var(--black); }
    .section-nav a[aria-current='true'] {
      color: var(--sienna);
      border-bottom-color: var(--sienna);
    }
    .section-nav a[hidden] { display: none; }
    .section-nav a:focus-visible {
      outline: 2px solid var(--sienna);
      outline-offset: 4px;
      border-radius: 2px;
    }

    /* Anchor jumps have to clear both the fixed header and the sticky nav, or
       the section title lands underneath them. Both heights are measured at
       runtime; the active-link check reads the same two numbers, so a jumped-to
       section is always the one the nav marks. */
    .work-section,
    .experiments,
    .xp { scroll-margin-top: calc(var(--header-h, 68px) + var(--section-nav-h, 44px) + 8px); }

    .work-section { margin-top: 0; }

    .card-title {
      font-family: var(--font-display);
      font-size: var(--fs-title-md);
      font-weight: 600;
      font-style: normal;
      line-height: 1.02;
      letter-spacing: -0.035em;
      font-variation-settings: 'opsz' 40;
      color: var(--black);
      margin-bottom: 10px;
      transition: color 0.3s;
    }
    .project-card:hover .card-title { color: var(--sienna); }

    .card-subtitle {
      font-size: var(--fs-300);
      line-height: 1.5;
      color: var(--muted);
      font-weight: 400;
      margin-bottom: 18px;
    }

    .card-desc {
      font-size: var(--fs-350);
      line-height: 1.72;
      color: var(--text-body);
      font-weight: 400;
      flex: 1;
      margin-bottom: 26px;
    }

    .card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 22px;
    }
    .card-tag {
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--muted);
      border: var(--hairline);
      border-radius: var(--radius-pill);
      padding: 5px 11px;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 18px;
      border-top: 1px solid var(--border);
    }
    .card-status {
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--sienna);
    }
    .card-link {
      font-family: var(--font-body);
      font-size: var(--fs-350);
      font-style: normal;
      font-weight: 600;
      color: var(--muted);
      transition: color 0.3s, gap 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }
    .project-card:hover .card-link { color: var(--black); gap: 12px; }

    /* ── EXPERIMENTS ── */
    .experiments {
      margin-top: 96px;
      padding-top: 40px;
      border-top: 1px solid var(--border);
    }
    .exp-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }
    .exp-title {
      font-family: var(--font-display);
      font-size: var(--fs-title-lg);
      font-weight: 600;
      letter-spacing: -0.035em;
      color: var(--black);
    }
    .exp-note {
      font-size: var(--fs-350);
      line-height: 1.65;
      color: var(--muted);
      max-width: 46ch;
    }
    .exp-item { margin-top: 8px; }
    .exp-caption {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 14px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* ── WORK EXPERIENCE ──
       Cards lead on the work, not the job title. The title sits in the small
       mono metadata line beside the dates, so the section doesn't open with two
       "Developer Advocate" headings. The result is the visual anchor because a
       quantified outcome carries further than a screenshot. */
    .xp { margin-top: 96px; padding-top: 40px; border-top: 1px solid var(--border); }

    /* Same grid and card treatment as the projects above. The employment history
       is secondary to the work, so it must not out-weigh it visually, which a
       full-width stack of long rows did. Everything past the hook lives on the
       card's own page. */
    .xp-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .xp-card {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 30px 32px 26px;
      border: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      transition: border-color 0.35s ease, background 0.35s ease, transform 0.35s cubic-bezier(0.2,0.8,0.3,1);
    }
    .xp-card::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: var(--sienna);
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.45s cubic-bezier(0.2,0.8,0.3,1);
    }
    .xp-card:hover {
      border-color: var(--sienna);
      background: var(--warm-white);
      transform: translateY(-3px);
    }
    .xp-card:hover::before { transform: scaleY(1); }
    .xp-card:focus-visible { outline: 2px solid var(--sienna); outline-offset: 4px; }

    .xp-meta {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
      margin: 0 0 14px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .xp-company { color: var(--black); font-weight: 700; }
    .xp-meta span:not(.xp-company)::before { content: '·'; margin-right: 10px; }

    .xp-headline {
      margin: 0 0 14px;
      font-family: var(--font-display);
      font-size: clamp(18px, 1.9vw, 23px);
      font-weight: 600;
      line-height: 1.24;
      letter-spacing: -0.022em;
      color: var(--black);
    }

    .xp-result {
      margin: 0 0 auto;
      padding-left: 14px;
      border-left: 2px solid var(--sienna);
      font-size: var(--fs-300);
      line-height: 1.6;
      color: var(--sienna);
    }

    .xp-foot {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-top: 22px;
    }
    .xp-link {
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.25s ease;
    }
    .xp-card:hover .xp-link { color: var(--sienna); }

    /* States the work is internal rather than leaving a card that looks like it
       forgot its images. */
    .xp-nda {
      flex-shrink: 0;
      padding: 3px 7px;
      border: 1px solid var(--border);
      border-radius: 2px;
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* Roles with a real result but nothing showable. A line, not a card. */
    .xp-compact {
      margin: 24px 0 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--border);
    }
    .xp-compact li { padding: 20px 0 0; }
    .xp-compact .xp-meta { margin-bottom: 8px; }
    .xp-compact-line {
      margin: 0;
      font-size: var(--fs-350);
      line-height: 1.65;
      color: var(--text-body);
      max-width: 74ch;
    }
    .xp-compact-sep { margin: 0 8px; color: var(--muted); }
    .xp-card:hover .xp-headline { color: var(--sienna); }
    .xp-headline { transition: color 0.25s ease; }

    .canvas-section {
      position: relative;
      width: 100%;
      height: 65vh;
      min-height: 400px;
      border: 1px solid var(--border);
      overflow: hidden;
    }

    #heroCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    /* ── FACE CLOUD ──
       The cloud is additive glow, so its stage stays dark in both themes.
       The box reads as a screen rather than as part of the page surface.
       Every color in here is therefore fixed against that dark ground, not
       themed: the button's text sits at 17.6:1 on it, the status line at
       12.9:1 and the button border at 5.6:1. */
    .face-stage { background: #0B0507; }
    #faceCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    .face-video {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
    .face-controls {
      position: absolute;
      left: 0;
      right: 0;
      bottom: var(--space-5);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-3);
      padding: 0 var(--space-5);
      text-align: center;
    }
    .face-btn {
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: var(--track-meta);
      text-transform: uppercase;
      color: #F2EFE9;
      background: rgba(11, 5, 7, 0.55);
      border: 1px solid rgba(242, 239, 233, 0.55);
      border-radius: 999px;
      padding: 10px var(--space-5);
      cursor: pointer;
      backdrop-filter: blur(3px);
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }
    .face-btn:hover,
    .face-btn:focus-visible {
      background: rgba(242, 239, 233, 0.16);
      border-color: #F2EFE9;
    }
    .face-btn[disabled] { opacity: 0.55; cursor: default; }
    .face-btn[hidden] { display: none; }
    .face-status {
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      letter-spacing: var(--track-meta);
      text-transform: uppercase;
      color: rgba(242, 239, 233, 0.86);
    }
    .face-status:empty { display: none; }
    .face-src {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .face-src:hover { color: var(--sienna); }

    @media (max-width: 900px) {
      .tech-page { padding: 100px 24px 72px; }
      .project-grid { grid-template-columns: 1fr; }
      .project-card { padding: 26px 22px; }
      .canvas-section { height: 50vh; min-height: 320px; }
      .experiments { margin-top: 64px; padding-top: 32px; }
      .xp { margin-top: 64px; padding-top: 32px; }
      .xp-grid { grid-template-columns: 1fr; }
      .xp-card { padding: 26px 22px; }
    }
  </style>

  <div class="tech-page">

    <header class="page-header reveal">
      {/* Title and search share one baseline. The search reaches every section
          on the page, since projects, experiments and roles all carry data-search. */}
      <div class="page-header-top">
        <h1 class="page-title"><em>Work</em></h1>

        <div class="filters">
          <label class="filter-search">
            <span class="visually-hidden">Search this page</span>
            <input
              type="search"
              id="projectSearch"
              placeholder="Search projects, experiments, and roles"
              autocomplete="off"
              aria-describedby="filterCount"
            />
            <button type="button" class="filter-clear" id="filterClear" aria-label="Clear search">×</button>
          </label>

          <p class="filter-count" id="filterCount" role="status" aria-live="polite"></p>
        </div>
      </div>
    </header>

    <nav class="section-nav" id="sectionNav" aria-label="Sections on this page">
      <a href="#projects" data-nav="projects">Projects</a>
      <a href="#experiments" data-nav="experiments">Experiments</a>
      <a href="#experience" data-nav="experience">Experience</a>
    </nav>

    <p class="no-results" id="noResults" hidden>Nothing matches that. Try another word, or clear the search.</p>

    <section class="work-section reveal" id="projects" aria-labelledby="projectsLabel">
      <div class="exp-head">
        <h2 class="exp-title" id="projectsLabel">Projects</h2>
      </div>

      <div class="project-grid" id="projectGrid">
      {projects.map((p) => (
        <a
          href={p.link}
          class="project-card reveal"
          data-title={p.title.toLowerCase()}
          data-search={`${p.title} ${p.subtitle} ${p.desc} ${p.tags.join(' ')}`.toLowerCase()}
          data-tags={p.tags.join('|')}
        >
          <h2 class="card-title">{p.title}</h2>
          <p class="card-subtitle">{p.subtitle}</p>
          <p class="card-desc">{p.desc}</p>
          <div class="card-tags">
            {p.tags.map(t => <span class="card-tag">{t}</span>)}
          </div>
          <div class="card-footer">
            <span class="card-status">{p.status}</span>
            <span class="card-link">View project</span>
          </div>
        </a>
      ))}
      </div>
    </section>

    <section class="experiments reveal" id="experiments">
      <div class="exp-head">
        <h2 class="exp-title">Experiments</h2>
        <p class="exp-note">
          Prototypes and things that aren't finished. Small, occasionally pointless,
          and where most of the interesting problems turn up first.
        </p>
      </div>

      <div
        class="exp-item"
        data-search="thread drawing pick a color draw on the shirt canvas path2d embroidery experiment prototype"
      >
        <div class="canvas-section">
          <canvas id="heroCanvas"></canvas>
        </div>
        <div class="exp-caption">
          <span>Thread drawing, pick a color and draw on the shirt</span>
          <span>Canvas · Path2D</span>
        </div>
      </div>

      <div
        class="exp-item"
        data-search="face cloud point cloud webgl three.js mediapipe face landmarks computer vision camera webcam portrait light experiment prototype"
      >
        <div class="canvas-section face-stage">
          <canvas id="faceCanvas"></canvas>
          <!-- Off-screen rather than display:none, because a hidden video element
               stops decoding frames in some browsers, and the detector reads
               from it every frame. -->
          <video id="faceVideo" class="face-video" playsinline muted autoplay></video>
          <div class="face-controls">
            <button id="faceCameraBtn" type="button" class="face-btn">
              Turn on the camera
            </button>
            <p id="faceStatus" class="face-status" role="status" aria-live="polite"></p>
          </div>
        </div>
        <div class="exp-caption">
          <span>
            Face cloud. 478 landmarks, tracked live and drawn as points of light.
            <a
              class="face-src"
              href="https://github.com/ckaren28/face-cloud"
              target="_blank"
              rel="noopener noreferrer"
            >Source</a>
          </span>
          <span>Three.js · MediaPipe · WebGL</span>
        </div>
      </div>
    </section>

    {experience.length > 0 && (
      <section class="xp reveal" id="experience" aria-labelledby="experienceLabel">
        <div class="exp-head">
          <h2 class="exp-title" id="experienceLabel">Experience</h2>
          <p class="exp-note">
            Design and front-end work, and the four years of developer advocacy
            in the middle of it. Where the evidence survives, it's here.
          </p>
        </div>

        <div class="xp-grid">
          {experience.map(({ data, slug }) => (
            <a
              class="xp-card"
              href={`/experience/${slug}`}
              data-search={`${data.company} ${data.role} ${data.headline} ${data.result}`.toLowerCase()}
            >
              <p class="xp-meta">
                <span class="xp-company">{data.company}</span>
                <span>{data.role}</span>
              </p>

              <h3 class="xp-headline">{data.headline}</h3>
              <p class="xp-result">{data.result}</p>

              <span class="xp-foot">
                <span class="xp-link">Read the full case</span>
                {data.nda && <span class="xp-nda">Internal</span>}
              </span>
            </a>
          ))}
        </div>

        {compactExperience.length > 0 && (
          <ul class="xp-compact">
            {compactExperience.map(({ data }) => (
              <li data-search={`${data.company} ${data.role} ${data.headline} ${data.result}`.toLowerCase()}>
                <p class="xp-meta">
                  <span class="xp-company">{data.company}</span>
                  <span>{data.role}</span>
                  {data.nda && <span class="xp-nda">Internal</span>}
                </p>
                <p class="xp-compact-line">
                  {data.headline}<span class="xp-compact-sep">·</span>{data.result}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

  </div>

  <script>
    // ── SHUTTER ARRIVAL ──
    // The opening half of the transition the landing page started. Runs on
    // every load and no-ops unless the shutter set its flag, but it always
    // lifts the pre-paint cover, so this page can't be left behind one.
    import { playArrival } from '../../scripts/shutter';
    playArrival();
  </script>

  <script>
    // ── STICKY SECTION NAV ──
    (function () {
      const nav = document.getElementById('sectionNav');
      // The site header is fixed and opaque, so the nav has to stick below it.
      // Its height changes with the breakpoints and once the display font
      // loads, so it's measured rather than guessed.
      const siteHeader = document.querySelector<HTMLElement>('header:not(.page-header)');
      if (!nav || !siteHeader) return;

      const root = document.documentElement;
      // getBoundingClientRect, not offsetHeight: offsetHeight rounds to whole
      // pixels, so a header that actually measures 67.5px reports 68 and the
      // nav parks half a pixel too low, which is a hairline of the page
      // scrolling past in the gap. The rect keeps the fraction.
      const setOffset = () => {
        root.style.setProperty('--header-h', `${siteHeader.getBoundingClientRect().height}px`);
        root.style.setProperty('--section-nav-h', `${nav.getBoundingClientRect().height}px`);
      };
      setOffset();
      new ResizeObserver(setOffset).observe(siteHeader);
      new ResizeObserver(setOffset).observe(nav);
      document.fonts?.ready.then(setOffset);

      const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
      const sections = links
        .map((link) => ({ link, el: document.getElementById(link.dataset.nav!) }))
        .filter((s): s is { link: HTMLAnchorElement; el: HTMLElement } => !!s.el);

      // Whichever section has crossed just under the nav is the current one.
      let queued = false;
      function mark() {
        queued = false;
        // Matches the sections' scroll-margin (+ a few px of slack), so the
        // section an anchor jumps to is the one that reads as current.
        const line = siteHeader!.offsetHeight + nav!.offsetHeight + 12;
        let current: HTMLAnchorElement | null = null;
        for (const s of sections) {
          if (!s.el.hidden && s.el.getBoundingClientRect().top <= line) current = s.link;
        }
        for (const { link } of sections) {
          if (link === current) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
      addEventListener('scroll', () => {
        if (!queued) { queued = true; requestAnimationFrame(mark); }
      }, { passive: true });
      addEventListener('resize', mark, { passive: true });
      mark();
    })();
  </script>

  <script>
    // ── SEARCH ──
    (function () {
      const input  = document.getElementById('projectSearch') as HTMLInputElement | null;
      const clear  = document.getElementById('filterClear');
      const status = document.getElementById('filterCount');
      const empty  = document.getElementById('noResults');
      const nav    = document.getElementById('sectionNav');
      if (!input || !status || !empty) return;

      // Every section takes part, so "wix" finds the role and "canvas" finds
      // the experiment, not just the project grid.
      const groups = ['projects', 'experiments', 'experience']
        .map((id) => ({
          section: document.getElementById(id),
          items: Array.from(document.querySelectorAll<HTMLElement>(`#${id} [data-search]`)),
          link: nav?.querySelector<HTMLElement>(`[data-nav="${id}"]`) ?? null,
        }))
        .filter((g): g is { section: HTMLElement; items: HTMLElement[]; link: HTMLElement | null } =>
          !!g.section);

      function apply() {
        const q = input!.value.trim().toLowerCase();
        let total = 0;

        for (const g of groups) {
          let shown = 0;
          for (const item of g.items) {
            const show = !q || (item.dataset.search ?? '').includes(q);
            item.hidden = !show;
            if (show) shown++;
          }
          // An emptied section goes, and its anchor goes with it, since a sticky
          // link to nothing is a dead end.
          g.section.hidden = shown === 0;
          if (g.link) g.link.hidden = shown === 0;
          total += shown;
        }

        clear?.classList.toggle('on', q.length > 0);
        empty!.hidden = total > 0;
        // Announces that filtering happened without printing a tally.
        status!.textContent = q && total > 0 ? `Filtered by “${q}”` : '';
      }

      input.addEventListener('input', apply);
      clear?.addEventListener('click', () => { input!.value = ''; input!.focus(); apply(); });

      // Escape clears the search
      input.addEventListener('keydown', e => {
        if (e.key === 'Escape') { input!.value = ''; apply(); }
      });

      apply();
    })();
  </script>

  <script>
    // T-SHIRT THREAD DRAWING
    (function() {
      const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;

      // The shirt is off-white or black; you pick the thread. Every thread sits
      // in a mid-luminance band so it clears 3:1 on BOTH shirts. The worst
      // pairing is 3.18:1.
      const SHIRT_OFFWHITE = '#F2EFE9';
      const SHIRT_BLACK    = '#1C1418';
      const THREAD_COLORS  = ['#9B5566','#4E6FA8','#C05A4A','#7A6E95','#8A7D86','#5F8F86','#B0574F'];

      // SVG path data extracted from Basic T Shirt.svg (viewBox 0 0 595.28 841.89)
      const SVG_SHIRT        = 'M176.24,594.87l247.9,.32c-1.03,-65.35,-2.07,-130.7,-3.1,-196.05l35.61,15.42,48.03,-62.22,-93.95,-75.82,-80.52,-29.08s-3.95,43.87,-31.85,45.38c-27.9,1.51,-34.43,-43.97,-34.43,-43.97l-70.76,23.49,-102.59,79.4,49.45,62.81,36.02,-17.37c.06,65.89,.12,131.78,.18,197.67Z';
      const SVG_COLLAR_FILL  = 'M265.35,247.58s31.65,10.12,63.76,-.88c.6,3.91,3.03,22.39,-9.15,36.76c-2.92,3.45,-10.21,12.04,-21.59,12.47c-11.08,.42,-18.84,-7.18,-21.61,-9.89c-14.39,-14.08,-11.85,-35.22,-11.42,-38.46Z';

      let shirtColor  = SHIRT_OFFWHITE;
      let threadColor = THREAD_COLORS[0];

      interface Pt { x: number; y: number; }
      interface Trail { pts: Pt[]; color: string; }

      let trails: Trail[] = [];
      let currentTrail: Trail | null = null;
      let isDrawing = false;
      let W = 0, H = 0;
      let shirtPath: Path2D | null = null;
      let shirtMx: DOMMatrix | null = null;
      let shirtMidY = 0;
      let shirtScale = 1;
      let shirtBottomY = 0;
      let hintOpacity = 1;
      let hasDrawn = false;
      let swatchHits: { x: number; y: number; r: number; color: string }[] = [];

      function isDark() {
        return document.documentElement.getAttribute('data-theme') === 'dark';
      }

      const SVG_SHIRT_LEFT = 91, SVG_SHIRT_TOP = 247, SVG_SHIRT_W = 414, SVG_SHIRT_H = 348;

      function buildShirtPath() {
        // 0.58 wasted most of a phone's width and left a torso too narrow to
        // hold the hint text. Narrow screens get a much larger share.
        const widthShare = W < 560 ? 0.92 : W < 900 ? 0.74 : 0.58;
        const targetW = Math.min(W * widthShare, H * 0.68);
        const scale   = targetW / SVG_SHIRT_W;
        shirtScale = scale;
        const offsetX = W / 2 - (SVG_SHIRT_LEFT + SVG_SHIRT_W / 2) * scale;
        const offsetY = H * 0.05 + 50 - SVG_SHIRT_TOP * scale;
        shirtMx = new DOMMatrix([scale, 0, 0, scale, offsetX, offsetY]);
        const raw = new Path2D(SVG_SHIRT);
        shirtPath = new Path2D();
        shirtPath.addPath(raw, shirtMx);
        shirtBottomY = offsetY + 595  * scale;
        shirtMidY    = offsetY + (SVG_SHIRT_TOP + SVG_SHIRT_H / 2) * scale;
      }

      function buildSwatchHits() {
        const n = THREAD_COLORS.length;
        const r = Math.min(13, (W * 0.75) / (n * 3.2));
        const spacing = r * 3.2;
        const startX  = W / 2 - ((n - 1) * spacing) / 2;
        const swY = shirtBottomY + (H * 0.90 - shirtBottomY) * 0.42;
        swatchHits = THREAD_COLORS.map((color, i) => ({
          x: startX + i * spacing, y: swY, r, color,
        }));
      }

      function resize() {
        W = canvas!.width  = canvas!.offsetWidth;
        H = canvas!.height = canvas!.offsetHeight;
        buildShirtPath();
        buildSwatchHits();
      }

      function hexToRgb(hex: string) {
        return { r: parseInt(hex.slice(1,3),16), g: parseInt(hex.slice(3,5),16), b: parseInt(hex.slice(5,7),16) };
      }

      function txPath(d: string) {
        const p = new Path2D(); p.addPath(new Path2D(d), shirtMx!); return p;
      }

      function drawGrid() {
        const dark = isDark();
        ctx.strokeStyle = dark ? 'rgba(242,239,233,0.05)' : 'rgba(42,14,19,0.09)';
        ctx.lineWidth = 0.5;
        const sp = 22;
        for (let x = 0; x < W; x += sp) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
        for (let y = 0; y < H; y += sp) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }
      }

      function drawShirtFill() {
        if (!shirtPath || !shirtMx) return;
        const dark = isDark();
        ctx.save();
        ctx.shadowColor  = dark ? 'rgba(0,0,0,0.70)' : 'rgba(42,14,19,0.28)';
        ctx.shadowBlur   = 38;
        ctx.shadowOffsetX = 6;
        ctx.shadowOffsetY = 16;
        ctx.fillStyle = shirtColor;
        ctx.fill(shirtPath);
        ctx.shadowColor = 'transparent';
        ctx.shadowBlur  = 0;
        ctx.shadowOffsetX = 0;
        ctx.shadowOffsetY = 0;
        ctx.fillStyle = dark ? 'rgba(0,0,0,0.20)' : 'rgba(0,0,0,0.11)';
        ctx.fill(txPath(SVG_COLLAR_FILL));
        ctx.restore();
      }

      function drawThreads() {
        if (!shirtPath || trails.length === 0) return;
        ctx.save();
        ctx.clip(shirtPath);
        trails.forEach(trail => {
          if (trail.pts.length < 2) return;
          const { r, g, b } = hexToRgb(trail.color);
          ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.lineWidth = 1.6;
          for (let i = 1; i < trail.pts.length; i++) {
            const a = trail.pts[i-1], bp = trail.pts[i];
            ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(bp.x,bp.y);
            ctx.strokeStyle = `rgba(${r},${g},${b},0.80)`;
            ctx.stroke();
          }
        });
        ctx.restore();
      }

      function drawShirtOverlay() {
        if (!shirtPath || !shirtMx) return;
        const dark = isDark();
        ctx.save();
        ctx.strokeStyle = dark ? 'rgba(242,239,233,0.42)' : 'rgba(42,14,19,0.38)';
        ctx.lineWidth = 1.5;
        ctx.stroke(shirtPath);
        ctx.restore();
      }

      function drawSwatches() {
        const dark = isDark();
        swatchHits.forEach(sw => {
          ctx.save();
          ctx.beginPath();
          ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);
          ctx.fillStyle = sw.color;
          ctx.fill();
          const selected = sw.color === threadColor;
          ctx.strokeStyle = selected
            ? (dark ? 'rgba(242,239,233,0.95)' : 'rgba(42,14,19,0.85)')
            : (dark ? 'rgba(242,239,233,0.45)' : 'rgba(42,14,19,0.45)');
          ctx.lineWidth = selected ? 2.5 : 0.5;
          ctx.stroke();
          if (selected) {           // outer ring, so the choice reads at a glance
            ctx.beginPath();
            ctx.arc(sw.x, sw.y, sw.r + 5, 0, Math.PI * 2);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
          ctx.restore();
        });
        const first = swatchHits[0];
        if (!first) return;
        ctx.save();
        ctx.font = '500 8px "Instrument Sans", sans-serif';
        ctx.letterSpacing = '0.16em';
        ctx.fillStyle = isDark() ? 'rgba(242,239,233,0.70)' : 'rgba(42,14,19,0.60)';
        ctx.textAlign = 'center';
        ctx.fillText('THREAD COLOR', W / 2, first.y - first.r - 12);
        ctx.textAlign = 'left'; ctx.letterSpacing = '0';
        ctx.restore();
      }

      const isTouch = window.matchMedia('(pointer: coarse)').matches;

      function shirtTextColor() {
        const hex = shirtColor.replace('#', '');
        const r = parseInt(hex.slice(0,2),16), g = parseInt(hex.slice(2,4),16), b = parseInt(hex.slice(4,6),16);
        const lum = (r * 299 + g * 587 + b * 114) / 1000;
        return lum > 128 ? '44,26,14' : '240,232,220';
      }

      // The torso, not the full silhouette, because the sleeves flare well outside the
      // band the hint can actually sit in, so they can't be used to size it.
      const SVG_TORSO_LEFT = 176.24, SVG_TORSO_RIGHT = 424.14;

      /* Word-wrap the hint to a given width, shrinking the face a step at a
         time until it fits. Returns null if even the longest single word can't
         fit, in which case drawing it would only be clipped again. */
      function fitHintLines(phrases: string[], maxW: number) {
        for (let size = 10; size >= 7.5; size -= 0.5) {
          ctx.font = `500 ${size}px "Instrument Sans", sans-serif`;
          ctx.letterSpacing = size >= 9 ? '0.14em' : '0.08em';
          const out: string[] = [];
          let fits = true;
          for (const phrase of phrases) {
            let cur = '';
            for (const word of phrase.split(' ')) {
              const test = cur ? `${cur} ${word}` : word;
              if (ctx.measureText(test).width <= maxW) { cur = test; continue; }
              if (cur) out.push(cur);
              if (ctx.measureText(word).width > maxW) fits = false;
              cur = word;
            }
            if (cur) out.push(cur);
          }
          if (fits) return { size, lines: out };
        }
        return null;
      }

      function drawHint() {
        if (hintOpacity <= 0 || !shirtPath) return;
        const base = shirtTextColor();
        const phrases = isTouch
          ? ['DRAG INSIDE THE SHIRT TO STITCH', 'DOUBLE-TAP TO FLIP THE SHIRT']
          : ['CLICK & DRAG INSIDE THE SHIRT TO STITCH', 'DOUBLE-CLICK TO FLIP THE SHIRT'];

        ctx.save();
        const torsoW = (SVG_TORSO_RIGHT - SVG_TORSO_LEFT) * shirtScale;
        const fitted = fitHintLines(phrases, torsoW - 18);
        if (!fitted) { ctx.restore(); return; }

        // Still clipped to the shirt, so the text reads as printed on it, but
        // it is now laid out to fit inside rather than being sliced by the edge.
        ctx.clip(shirtPath);
        ctx.font = `500 ${fitted.size}px "Instrument Sans", sans-serif`;
        ctx.letterSpacing = fitted.size >= 9 ? '0.14em' : '0.08em';
        ctx.fillStyle = `rgba(${base},${hintOpacity * 0.52})`;
        ctx.textAlign = 'center';
        const lh  = fitted.size * 1.9;
        const top = shirtMidY - ((fitted.lines.length - 1) * lh) / 2;
        fitted.lines.forEach((line, i) => ctx.fillText(line, W / 2, top + i * lh));
        ctx.textAlign = 'left'; ctx.letterSpacing = '0';
        ctx.restore();
      }

      function drawFrame() {
        requestAnimationFrame(drawFrame);
        ctx.clearRect(0, 0, W, H);
        drawGrid();
        drawShirtFill();
        drawThreads();
        drawShirtOverlay();
        if (hasDrawn) hintOpacity = Math.max(0, hintOpacity - 0.012);
        drawHint();
        drawSwatches();
      }

      function getXY(e: MouseEvent | Touch) {
        const rect = canvas!.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      }
      function inShirt(x: number, y: number) {
        return shirtPath ? ctx.isPointInPath(shirtPath, x, y) : false;
      }
      function hitSwatch(x: number, y: number) {
        return swatchHits.find(s => Math.hypot(x - s.x, y - s.y) <= s.r * 1.5);
      }
      function addPoint(x: number, y: number) {
        if (!currentTrail) {
          currentTrail = { pts: [], color: threadColor };
          trails.push(currentTrail);
        }
        const last = currentTrail.pts[currentTrail.pts.length - 1];
        if (!last || Math.hypot(x - last.x, y - last.y) > 4) {
          currentTrail.pts.push({ x, y });
          hasDrawn = true;
        }
      }

      const section = canvas!.parentElement!;

      section.addEventListener('mousedown', (e: MouseEvent) => {
        const { x, y } = getXY(e);
        const sw = hitSwatch(x, y);
        if (sw) { threadColor = sw.color; return; }
        if (inShirt(x, y)) { isDrawing = true; currentTrail = null; addPoint(x, y); }
      });
      section.addEventListener('mousemove', (e: MouseEvent) => {
        if (!isDrawing) return;
        const { x, y } = getXY(e);
        if (inShirt(x, y)) addPoint(x, y);
      });
      section.addEventListener('mouseup',    () => { isDrawing = false; currentTrail = null; });
      section.addEventListener('mouseleave', () => { isDrawing = false; currentTrail = null; });
      section.addEventListener('dblclick', (e: MouseEvent) => {
        const { x, y } = getXY(e);
        if (inShirt(x, y)) {
          shirtColor = shirtColor === SHIRT_OFFWHITE ? SHIRT_BLACK : SHIRT_OFFWHITE;
        }
      });

      let lastTap = 0;
      section.addEventListener('touchstart', (e: TouchEvent) => {
        const { x, y } = getXY(e.touches[0]);
        const sw = hitSwatch(x, y);
        if (sw) { threadColor = sw.color; return; }
        if (inShirt(x, y)) { isDrawing = true; currentTrail = null; addPoint(x, y); }
        const now = Date.now();
        if (now - lastTap < 300 && inShirt(x, y)) {
          shirtColor = shirtColor === SHIRT_OFFWHITE ? SHIRT_BLACK : SHIRT_OFFWHITE;
        }
        lastTap = now;
      }, { passive: true });
      section.addEventListener('touchmove', (e: TouchEvent) => {
        e.preventDefault();
        if (!isDrawing) return;
        const { x, y } = getXY(e.touches[0]);
        if (inShirt(x, y)) addPoint(x, y);
      }, { passive: false });
      section.addEventListener('touchend', () => { isDrawing = false; currentTrail = null; });

      window.addEventListener('resize', resize);
      resize();
      drawFrame();
    })();
  </script>

  <script>
    import { initFaceCloud } from '../../scripts/face-cloud';
    initFaceCloud();
  </script>

</MainLayout>
