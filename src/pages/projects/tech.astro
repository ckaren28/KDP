---
// Lab (Nov 2026 redesign). Projects use the same cards as the homepage work;
// experiments are a words-only list. Hovering a row shows a small preview,
// and each row links to the code on GitHub so anyone can fork and run it.
// The live demos that used to run inline here are still in git history:
// the permalinks below point at the last commit that had them.
import MainLayout from '../../layouts/MainLayout.astro';
import WorkCards from '../../components/WorkCards.astro';
import HoverPeek from '../../components/HoverPeek.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.listed !== false)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => {
    const slug = p.id.replace(/\.mdx?$/, '');
    return {
      href: `/projects/${slug}`,
      title: p.data.title,
      left: p.data.subtitle ?? '',
      right: p.data.live_url ? 'Live' : String(p.data.date.getUTCFullYear()),
      peek: `/images/lab/${slug}.jpg`,
    };
  });

const KDP = 'https://github.com/ckaren28/KDP/blob/ee1ba9310de05ea5ab1d7c318447bec9ab8f26a7';
const experiments = [
  { title: 'Thread drawing', what: 'Canvas · Path2D', code: 'https://github.com/ckaren28/thread-drawing', peek: '/images/lab/exp-thread.jpg' },
  { title: 'Face cloud', what: 'Three.js · MediaPipe · WebGL', code: 'https://github.com/ckaren28/face-cloud', peek: '/images/lab/exp-face.jpg' },
  { title: 'Incense, five ways', what: 'SVG · Canvas · WebGL · Three.js · GSAP', code: `${KDP}/src/components/tools/IncenseFiveWays.astro`, open: '/projects/incense-five-ways', peek: '/images/incense-five-ways-thumb.jpg' },
  { title: 'Riso ink chooser', what: 'Canvas · Color science', code: `${KDP}/public/demos/riso-ink-chooser.html`, open: '/demos/riso-ink-chooser.html', peek: '/images/riso-ink-chooser-thumb.jpg' },
];
---

<MainLayout title="Lab · Karen Dettmar">
  <div class="lab">
    <h1 class="lab-title">Lab</h1>

    <section aria-labelledby="projectsLabel">
      <h2 class="sr-only" id="projectsLabel">Projects</h2>
      <WorkCards items={projects} />
    </section>

    <section class="xps" aria-labelledby="xpLabel">
      <h2 class="xps-title" id="xpLabel">Experiments</h2>
      <ul>
        {experiments.map((x) => (
          <li class="xp" data-peek={x.peek}>
            <a class="xp-name" href={x.code} target="_blank" rel="noopener noreferrer">{x.title}</a>
            <span class="xp-what">{x.what}</span>
            <span class="xp-links">
              {x.open && <a href={x.open}>Open</a>}
              <a href={x.code} target="_blank" rel="noopener noreferrer">Code ↗</a>
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <HoverPeek />

  <style>
    .lab {
      max-width: 1240px;
      margin: 0 auto;
      padding: 24px max(24px, env(safe-area-inset-right, 0px)) 96px max(24px, env(safe-area-inset-left, 0px));
    }
    .lab-title {
      font-family: var(--font-display); font-stretch: var(--stretch-display); font-weight: 400;
      font-size: clamp(56px, 8vw, 112px); line-height: 1; letter-spacing: -.015em;
      margin: 0 0 40px; color: var(--black);
    }
    .xps { margin-top: 88px; }
    .xps-title { font-family: var(--font-display); font-stretch: var(--stretch-display); font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1; margin: 0 0 20px; color: var(--black); }
    .xps ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .xp {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; align-items: baseline; gap: 24px;
      padding: 18px 0; border-bottom: 1px solid var(--border);
    }
    .xp-name { font-family: var(--font-display); font-stretch: var(--stretch-display); font-size: 28px; line-height: 1.1; color: var(--black); text-decoration: none; }
    .xp:hover .xp-name { color: var(--sienna); }
    .xp-what { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
    .xp-links { display: flex; gap: 18px; font-family: var(--font-mono); font-size: 11px; }
    .xp-links a { color: var(--sienna); text-decoration: none; }
    .xp-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .xp a:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }
    @media (max-width: 700px) {
      .lab { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
      .xp { grid-template-columns: 1fr auto; gap: 6px 16px; }
      .xp-what { grid-column: 1; grid-row: 2; }
      .xp-links { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    }
  </style>
</MainLayout>
