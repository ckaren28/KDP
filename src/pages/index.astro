---
// This page does not go through MainLayout, so it does not inherit global.css,
// and that is where the self-hosted @font-face rules are reached from. Space
// Mono carries every small label on this page (the cue, the role, the location,
// the shutter's label, the hint, the email); without this import the only face
// the page declares is the Bricolage that comes from Google in the head, and
// all of that type silently falls back to whatever ui-monospace resolves to.
// It looks correct on a machine with the fonts installed locally, which is
// exactly why it has to be an import and not an assumption.
import '../styles/fonts.css';
import '../styles/darkroom.css';
import ThemeSwitch from '../components/global/ThemeSwitch.astro';
import Shutter from '../components/global/Shutter.astro';
import { SITE_TITLE } from '../consts';

const EMAIL = 'karen.dettmar@gmail.com';
const description = 'Karen Dettmar, Creative Technologist in New York.';

// Rendered server-side, not injected by JS: the h1 has to carry real text in
// the served HTML for crawlers and for anyone arriving without the script.
// darkroom.ts picks these spans up rather than creating them.
const LINES = ['KAREN', 'DETTMAR'];
---

<!DOCTYPE html>
<html lang="en" class="dk-root" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{SITE_TITLE} · Creative Technologist</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Theme must resolve before paint. The darkroom opens dark; a stored
       choice from anywhere on the site wins. -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'dark');
    })();
  </script>
  <link rel="canonical" href="https://karendettmar.com/" />
  <meta property="og:title" content={`${SITE_TITLE} · Creative Technologist`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap"
    rel="stylesheet"
  />
</head>

<body class="dk">
  <a href="#main" class="dk-skip">Skip to content</a>

  <canvas class="dk-stage" aria-hidden="true"></canvas>
  <div class="dk-grain" aria-hidden="true"></div>

  <div class="dk-id" id="main" tabindex="-1">
    <h1 class="dk-name">
      <!-- The h1 keeps its heading role. The visual letters are aria-hidden so
           they aren't spelled out one span at a time; this carries the name. -->
      <span class="dk-sr">Karen Dettmar</span>
      {LINES.map((word, li) => (
        <span class="dk-line" data-l={li} aria-hidden="true">
          {[...word].map((ch, i) => (
            <span
              class="dk-ltr"
              style={i > 0 && ch === 'T' && word[i - 1] === 'T' ? 'margin-left:0.06em' : undefined}
            >{ch}</span>
          ))}
        </span>
      ))}
      <span class="dk-cue" aria-hidden="true">
        <span class="dk-cue-grip"></span>
        Grab a letter and pull
      </span>
      <div class="dk-card" id="dkLink" aria-hidden="true">
        <!-- Straight to /projects/tech, not /projects: that route is a 301 and
             the redirect hop would land between the closing blades and the
             opening ones. The nav keeps the tidy /projects URL.

             The line lives inside the shutter, so the sentence and the way in
             are one target rather than a statement with a door beside it. -->
        <Shutter href="/projects/tech" line="Easier to show you than explain." />
      </div>
    </h1>
    <!-- Keyboard equivalent of pulling a letter. A real button, so it isn't
         standing on the h1's role; visible only when focused. -->
    <button type="button" class="dk-reveal" aria-expanded="false" aria-controls="dkLink">
      Show introduction
    </button>
    <!-- One block, so it can step back as a unit while the introduction is
         open. See .dk-supporting in darkroom.css. -->
    <div class="dk-supporting">
      <div class="dk-rule" aria-hidden="true"></div>
      <p class="dk-role">Creative Technologist</p>
      <p class="dk-loc">New York</p>
    </div>
  </div>

  <nav class="dk-nav" aria-label="Primary">
    <a href="/" class="dk-who" aria-label="Karen Dettmar, home">KD</a>
    <ul>
      <li><a href="/projects">Work</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/cv">CV</a></li>
      <li class="dk-switch"><ThemeSwitch /></li>
    </ul>
  </nav>

  <p class="dk-hint" aria-hidden="true">Move to develop</p>
  <a href={`mailto:${EMAIL}`} class="dk-contact">{EMAIL}</a>
  <div class="dk-cur" aria-hidden="true"></div>

  <script>
    import { initDarkroom } from '../scripts/darkroom';
    import { initThemeTyping } from '../scripts/theme';
    import { initPrintEgg } from '../scripts/print';
    import { initCopyEmail } from '../scripts/copyEmail';
    initThemeTyping();
    initPrintEgg();
    initCopyEmail();
    initDarkroom(document.body);
  </script>
</body>
</html>
