---
// Homepage, Nov 2026 redesign ("taste and a little nerve").
// Hero: the headline with one blackletter word circled, and the poppable
// soap bubble. Work: ruled cards (title, one outcome sentence, org/role).
// `body` is the live site's longer description, kept for the copy rewrite.
import MainLayout from '../layouts/MainLayout.astro';
import Bubble from '../components/Bubble.astro';
import HoverPeek from '../components/HoverPeek.astro';
import WorkCards from '../components/WorkCards.astro';

const work = [
  {
    href: '/experience/wet-design',
    title: 'Redesigning employee travel at WET',
    body: 'I interviewed travelers, designed the workflow and built the Vue front end of a request-and-approval app that replaced a legacy system company-wide.',
    desc: 'Replaced a legacy travel system company-wide.',
    org: 'WET Design', role: 'Research, UX, sole front-end developer',
    peek: '/images/wet/travel-request-form.png',
  },
  {
    href: '/experience/wix',
    title: 'Designing and building an avatar builder for Wix DevCon',
    body: 'A generative avatar builder for a live developer conference, illustrated by Wix’s design team, that 77% of attendees used.',
    desc: '77% of attendees made an avatar.',
    org: 'Wix', role: 'Concept, interaction design, build',
    peek: '/images/wix/avatar-output.jpg',
  },
  {
    href: '/experience/cibt',
    title: 'Finding out why visa applicants were leaving',
    body: 'I redesigned an on-site survey so one week of answers outdrew the previous five and ranked why applicants were leaving.',
    desc: 'One week of survey answers outdrew the previous five.',
    org: 'CIBT', role: 'Research, survey design',
    peek: '/images/cibt/survey-themes.svg',
  },
  {
    href: '/experience/intuit',
    title: 'Making engineering maturity actionable',
    body: 'Making engineering maturity actionable: a leaderboard that tells teams what to do next. Password protected.',
    desc: 'A tournament that encouraged teams to level up, one sprint at a time.',
    org: 'Intuit', role: 'Private',
    peek: 'lock',
  },
  {
    href: '/experience/pixomondo',
    title: 'Pixomondo',
    body: 'Print campaigns for a VFX studio, and the site they pointed at.',
    desc: 'Print campaigns for a VFX studio, and the site they pointed at.',
    org: 'Pixomondo', role: 'Print and web',
    peek: '/images/pixomondo/star-trek-discovery.png',
  },
];
---

<MainLayout title="Karen Dettmar · UX Engineer and Design Technologist">
  <div class="home">
    <section class="hero" aria-label="Introduction">
      <div class="hero-copy">
        <h1>Interfaces with taste and a little
          <span class="rude">nerve<svg viewBox="0 0 240 80" preserveAspectRatio="none" aria-hidden="true"><path d="M14,44 C10,20 70,6 132,8 C196,10 238,24 230,48 C222,70 150,76 96,72 C40,68 6,58 12,36 C18,18 60,12 104,12"/></svg></span>.
        </h1>
        <p class="lede">I design and build interfaces, from employee workflows to interactive tools. Research, prototypes, and the details that make them work.</p>
      </div>
      <Bubble />
    </section>

    <section id="work" aria-labelledby="workLabel">
      <h2 class="sr-only" id="workLabel">Selected work</h2>
      <WorkCards items={work.map((w) => ({ href: w.href, title: w.title, desc: w.desc, left: w.org, right: w.role, peek: w.peek }))} />
    </section>

    <section class="hello" aria-label="Contact">
      <a class="big" href="mailto:karen.dettmar@gmail.com">Say hello →</a>
      <a class="lab" href="/projects/tech">Lab: tools and experiments</a>
    </section>
  </div>

  <HoverPeek />

  <script>
    // "nerve": draw the circle a beat after the type lands; hover redraws it.
    const rude = document.querySelector('.rude');
    if (rude) {
      const draw = () => { rude.classList.remove('go'); void (rude as HTMLElement).offsetWidth; rude.classList.add('go'); };
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => setTimeout(draw, 1300));
      rude.addEventListener('mouseenter', draw);
    }
  </script>

  <style>
    .home {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 max(24px, env(safe-area-inset-right, 0px)) 72px max(24px, env(safe-area-inset-left, 0px));
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: 24px;
      padding-block: clamp(32px, 6vw, 80px) 56px;
    }
    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(50px, 8vw, 112px);
      line-height: .98;
      letter-spacing: -.015em;
      margin: 0;
      color: var(--black);
      text-wrap: balance;
    }
    .rude { position: relative; display: inline-block; font-family: var(--font-black); color: var(--accent-loud); font-size: 1.06em; padding: 0 .08em; }
    .rude svg { position: absolute; inset: -18% -14% -22% -12%; width: 126%; height: 140%; overflow: visible; pointer-events: none; }
    .rude path { fill: none; stroke: var(--black); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 640; stroke-dashoffset: 640; }
    :global(.rude.go) path { animation: draw 1.4s var(--ease-slow) both; }
    @keyframes draw { from { stroke-dashoffset: 640; } to { stroke-dashoffset: 0; } }
    .lede { max-width: 44ch; margin: 28px 0 0; color: var(--muted); font-size: 18px; line-height: 1.55; }

    #work { padding-top: 16px; }
    .hello { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 12px; padding-top: 56px; }
    .big { font-family: var(--font-display); font-size: clamp(32px, 4vw, 52px); color: var(--black); text-decoration: none; }
    .big:hover { color: var(--sienna); font-style: italic; }
    .lab { font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
    .lab:hover { color: var(--sienna); }

    @media (max-width: 760px) {
      .hero { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .home { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
    }
    @media (prefers-reduced-motion: reduce) {
      .rude path { stroke-dashoffset: 0; }
    }
  </style>
</MainLayout>
