---
import '../styles/darkroom.css';
import ThemeSwitch from '../components/global/ThemeSwitch.astro';
import { SITE_TITLE } from '../consts';

const STUDIO = 'https://studio.karendettmar.com';
const GITHUB = 'https://github.com/ckaren28';
const description = 'Karen Dettmar — Creative Technologist and Design Engineer in New York.';
---

<!DOCTYPE html>
<html lang="en" class="dk-root" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{SITE_TITLE} — Creative Technologist &amp; Design Engineer</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Theme must resolve before paint. The darkroom opens dark; a stored
       choice from anywhere on the site wins. -->
  <script is:inline>
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'dark');
    })();
  </script>
  <link rel="canonical" href="https://karendettmar.com/" />
  <meta property="og:title" content={`${SITE_TITLE} — Creative Technologist & Design Engineer`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />
</head>

<body class="dk">
  <a href="#main" class="dk-skip">Skip to content</a>

  <canvas class="dk-stage" aria-hidden="true"></canvas>
  <div class="dk-grain" aria-hidden="true"></div>

  <div class="dk-id" id="main">
    <h1 class="dk-name" role="button" tabindex="0" aria-expanded="false" aria-controls="dkLink">
      <span class="dk-line" data-l="0"></span>
      <span class="dk-line" data-l="1"></span>
      <span class="dk-cue" aria-hidden="true">
        <span class="dk-cue-grip"></span>
        Grab a letter and pull
      </span>
      <a class="dk-link" id="dkLink" href="/projects" tabindex="-1" aria-hidden="true">View projects</a>
    </h1>
    <div class="dk-rule" aria-hidden="true"></div>
    <p class="dk-role">Creative Technologist · Design Engineer</p>
    <p class="dk-loc">New York</p>
  </div>

  <nav class="dk-nav" aria-label="Primary">
    <a href="/" class="dk-who">Karen Dettmar<i>New York</i></a>
    <ul>
      <li><a href="/projects">Work</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/cv">CV</a></li>
      <li><a href={STUDIO}>Studio ↗</a></li>
      <li>
        <a href={GITHUB} class="gh" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub
        </a>
      </li>
      <li class="dk-switch"><ThemeSwitch /></li>
    </ul>
  </nav>

  <p class="dk-hint" aria-hidden="true">Move to develop</p>
  <a href="/projects" class="dk-enter">See the work →</a>
  <div class="dk-cur" aria-hidden="true"></div>
  <p class="dk-msg" role="status" aria-live="polite"></p>

  <script>
    import { initDarkroom } from '../scripts/darkroom';
    import { initThemeTyping } from '../scripts/theme';
    import { initPrintEgg } from '../scripts/print';
    initThemeTyping();
    initPrintEgg();
    initDarkroom(document.body);
  </script>
</body>
</html>
