---
// Homepage, Nov 2026 redesign ("taste and a little nerve").
// Hero: the headline with one blackletter word circled, and the poppable
// portrait bubble. Work: ruled cards whose copy is the live site's own.
import MainLayout from '../layouts/MainLayout.astro';
import Bubble from '../components/Bubble.astro';

const work = [
  {
    href: '/experience/wet-design',
    title: 'Redesigning employee travel at WET',
    body: 'I interviewed travelers, designed the workflow and built the Vue front end of a request-and-approval app that replaced a legacy system company-wide.',
    org: 'WET Design', role: 'Research, UX, sole front-end developer',
    peek: '/images/wet/travel-request-form.png',
  },
  {
    href: '/experience/wix',
    title: 'Designing an avatar builder for Wix DevCon',
    body: 'A generative avatar builder for a live developer conference, illustrated by Wix’s design team, that 77% of attendees used.',
    org: 'Wix', role: 'Concept, interaction design, build',
    peek: '/images/wix/avatar-output.jpg',
  },
  {
    href: '/experience/cibt',
    title: 'Finding out why visa applicants were leaving',
    body: 'I redesigned an on-site survey so one week of answers outdrew the previous five and ranked why applicants were leaving.',
    org: 'CIBT', role: 'Research, survey design',
    peek: '/images/cibt/survey-themes.svg',
  },
  {
    href: '/experience/intuit',
    title: 'Intuit',
    body: 'Making engineering maturity actionable: a leaderboard that tells teams what to do next. Password protected.',
    org: 'Intuit', role: 'Private',
    peek: 'lock',
  },
  {
    href: '/experience/pixomondo',
    title: 'Pixomondo',
    body: 'Print campaigns for a VFX studio, and the site they pointed at.',
    org: 'Pixomondo', role: 'Print and web',
    peek: '/images/pixomondo/star-trek-discovery.png',
  },
];
---

<MainLayout title="Karen Dettmar · UX Engineer and Design Technologist">
  <div class="home">
    <section class="hero" aria-label="Introduction">
      <div class="hero-copy">
        <h1>Interfaces with taste and a little
          <span class="rude">nerve<svg viewBox="0 0 240 80" preserveAspectRatio="none" aria-hidden="true"><path d="M14,44 C10,20 70,6 132,8 C196,10 238,24 230,48 C222,70 150,76 96,72 C40,68 6,58 12,36 C18,18 60,12 104,12"/></svg></span>.
        </h1>
        <p class="lede">I design and build interfaces. Prototyping, thoughtful interaction, and the small details that make something feel finished. Always thinking about the tradeoffs.</p>
      </div>
      <Bubble />
    </section>

    <section id="work" aria-labelledby="workLabel">
      <h2 class="work-head" id="workLabel">Selected work</h2>
      <div class="cards">
        {work.map((w) => (
          <a class="card" href={w.href} data-peek={w.peek}>
            <span class="t">{w.title}<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2,10 L198,10" /></svg></span>
            <span class="d">{w.body}</span>
            <span class="r"><span>{w.org}</span><b>{w.role}</b></span>
          </a>
        ))}
      </div>
    </section>

    <section class="hello" aria-label="Contact">
      <a class="big" href="mailto:karen.dettmar@gmail.com">Say hello →</a>
      <a class="lab" href="/projects/tech">Lab: tools and experiments</a>
    </section>
  </div>

  <div class="peek" id="peek" aria-hidden="true"></div>

  <script>
    // "nerve": draw the circle a beat after the type lands; hover redraws it.
    const rude = document.querySelector('.rude');
    if (rude) {
      const draw = () => { rude.classList.remove('go'); void (rude as HTMLElement).offsetWidth; rude.classList.add('go'); };
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => setTimeout(draw, 1300));
      rude.addEventListener('mouseenter', draw);
    }

    // Card underline: a new hand-sketched stroke on every hover.
    const jit = (n: number) => (Math.random() * 2 - 1) * n;
    const sketch = () => {
      const y0 = 9 + jit(2), slope = jit(4);
      let d = `M${(2 + jit(2)).toFixed(1)},${(y0 + jit(1.5)).toFixed(1)}`;
      for (let x = 14; x <= 198; x += 10 + Math.random() * 8) d += ` L${x.toFixed(1)},${(y0 + slope * x / 200 + jit(1.7)).toFixed(1)}`;
      const back = 3 + jit(1.2), stop = 40 + Math.random() * 90;
      for (let x = 194; x >= stop; x -= 12 + Math.random() * 10) d += ` L${x.toFixed(1)},${(y0 + back + slope * x / 200 + jit(1.9)).toFixed(1)}`;
      return d;
    };
    document.querySelectorAll<SVGPathElement>('.card .t path').forEach((p) => {
      p.setAttribute('d', sketch());
      p.closest('.card')?.addEventListener('mouseenter', () => p.setAttribute('d', sketch()));
    });

    // Phones have no hover: draw each card's line as it scrolls into view.
    if (matchMedia('(hover: none)').matches) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('seen'); io.unobserve(e.target); }
      }), { threshold: 0.6 });
      document.querySelectorAll('.card').forEach((c) => io.observe(c));
    }

    // Hover preview: a small tilted print that trails the cursor.
    const peek = document.getElementById('peek');
    if (peek && matchMedia('(hover: hover)').matches) {
      let px = 0, py = 0, tx = 0, ty = 0, raf = 0;
      const move = () => {
        px += (tx - px) * 0.22; py += (ty - py) * 0.22;
        const tilt = Math.max(-6, Math.min(6, (tx - px) * 0.08)) - 2.5;
        peek.style.transform = `translate(${px}px, ${py}px) rotate(${tilt}deg)`;
        raf = requestAnimationFrame(move);
      };
      document.querySelectorAll<HTMLElement>('.card[data-peek]').forEach((card) => {
        card.addEventListener('mouseenter', (e) => {
          const src = card.dataset.peek!;
          peek.innerHTML = src === 'lock'
            ? '<div class="peek-lock"><div><b>Locked</b><br>Password protected</div></div>'
            : `<img alt="" src="${src}">`;
          tx = px = e.clientX + 18; ty = py = e.clientY + 16;
          peek.classList.add('on');
          if (!raf) move();
        });
        card.addEventListener('mousemove', (e) => {
          tx = Math.min(e.clientX + 18, innerWidth - 180);
          ty = Math.min(e.clientY + 16, innerHeight - 130);
        });
        card.addEventListener('mouseleave', () => { peek.classList.remove('on'); cancelAnimationFrame(raf); raf = 0; });
      });
    }
  </script>

  <style>
    .home {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 max(24px, env(safe-area-inset-right, 0px)) 72px max(24px, env(safe-area-inset-left, 0px));
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: 24px;
      padding-block: clamp(32px, 6vw, 80px) 56px;
    }
    h1 {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(50px, 8vw, 112px);
      line-height: .98;
      letter-spacing: -.015em;
      margin: 0;
      color: var(--black);
      text-wrap: balance;
    }
    .rude { position: relative; display: inline-block; font-family: var(--font-black); color: var(--accent-loud); font-size: 1.06em; padding: 0 .08em; }
    .rude svg { position: absolute; inset: -18% -14% -22% -12%; width: 126%; height: 140%; overflow: visible; pointer-events: none; }
    .rude path { fill: none; stroke: var(--black); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 640; stroke-dashoffset: 640; }
    :global(.rude.go) path { animation: draw 1.4s var(--ease-slow) both; }
    @keyframes draw { from { stroke-dashoffset: 640; } to { stroke-dashoffset: 0; } }
    .lede { max-width: 44ch; margin: 28px 0 0; color: var(--muted); font-size: 18px; line-height: 1.55; }

    .work-head {
      display: flex; justify-content: space-between; padding-block: 14px; margin: 0;
      font-family: var(--font-mono); font-size: 12px; font-weight: 400; letter-spacing: .04em; text-transform: uppercase; color: var(--muted);
    }
    .cards { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
    .card {
      grid-column: span 2;
      position: relative; display: flex; flex-direction: column; gap: 12px; min-width: 0;
      padding: 18px 20px 16px;
      border: 1px solid var(--border);
      color: var(--black); text-decoration: none; background: transparent;
      transition: transform .45s var(--ease-snap), background .25s, color .25s, border-color .25s;
    }
    .card:nth-child(-n+2) { grid-column: span 3; }
    .card:nth-child(-n+2) .t { font-size: 40px; }
    .t { position: relative; align-self: flex-start; font-family: var(--font-display); font-size: 30px; line-height: 1.02; text-wrap: balance; }
    .t svg { position: absolute; left: -2%; bottom: -.3em; width: 104%; height: .5em; overflow: visible; pointer-events: none; }
    .t path { fill: none; stroke: var(--accent-loud); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .55s var(--ease-slow); }
    .d { color: var(--muted); font-size: 15px; line-height: 1.5; transition: color .25s; }
    .r { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); transition: color .25s; }
    .r b { font-weight: 400; color: var(--sienna); text-align: right; }
    .card:hover, .card:focus-visible { background: var(--black); color: var(--off-white); border-color: var(--black); transform: translateY(-4px) rotate(-.7deg); }
    .card:hover .t, .card:focus-visible .t { font-style: italic; }
    .card:hover .t path, .card:focus-visible .t path, :global(.card.seen) .t path { stroke-dashoffset: 0; }
    .card:hover .d, .card:hover .r, .card:focus-visible .d, .card:focus-visible .r { color: var(--off-white); }
    .card:hover .r b, .card:focus-visible .r b { color: var(--accent-loud); }
    .card:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }

    .hello { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 12px; padding-top: 56px; }
    .big { font-family: var(--font-display); font-size: clamp(32px, 4vw, 52px); color: var(--black); text-decoration: none; }
    .big:hover { color: var(--sienna); font-style: italic; }
    .lab { font-family: var(--font-mono); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
    .lab:hover { color: var(--sienna); }

    .peek {
      position: fixed; left: 0; top: 0; z-index: 30; width: 160px; pointer-events: none;
      opacity: 0; transform: translate(-9999px, 0); transition: opacity .2s;
      border: 1px solid var(--black); background: var(--off-white); padding: 4px;
      box-shadow: 0 18px 40px -20px rgba(0,0,0,.45);
    }
    :global(.peek.on) { opacity: 1; }
    .peek :global(img) { display: block; width: 100%; height: 100px; object-fit: cover; object-position: top; }
    .peek :global(.peek-lock) { height: 100px; display: grid; place-items: center; text-align: center; background: var(--black); color: var(--off-white); font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; text-transform: uppercase; }
    .peek :global(.peek-lock b) { display: block; font-family: var(--font-black); font-weight: 400; font-size: 26px; color: var(--accent-loud); line-height: 1; text-transform: none; }

    @media (max-width: 980px) {
      .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .card, .card:nth-child(-n+2) { grid-column: span 1; }
      .card:first-child { grid-column: span 2; }
      .card:nth-child(2) .t { font-size: 30px; }
    }
    @media (max-width: 760px) {
      .hero { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .home { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
      .cards { grid-template-columns: 1fr; }
      .card, .card:first-child { grid-column: auto; }
      .card:first-child .t { font-size: 32px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .rude path { stroke-dashoffset: 0; }
      .card, .t path, .peek { transition: none; }
    }
  </style>
</MainLayout>
