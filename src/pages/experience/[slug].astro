---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import EncryptedCase from '../../components/EncryptedCase.astro';

export async function getStaticPaths() {
  // Compact roles render as a line on the work page and get no page of their own.
  const experience = (await getCollection('experience')).filter((e) => !e.data.compact);
  return experience.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
// Side menu: the summary, then every h2 in the body.
const toc = entry.data.toc ? [{ slug: 'overview', text: 'Overview' }, ...headings.filter((h) => h.depth === 2)] : [];
const d = entry.data;

---

<MainLayout title={`${d.company} · Karen Dettmar`}>
  {/* Kept out of search results: these pages are for people Karen sends here,
      not for search traffic. */}
  <meta slot="head" name="robots" content="noindex" />

  <style>
    .xpp {
      max-width: 780px;
      margin: 0 auto;
      padding: 48px 48px 100px;
    }

    .xpp-back {
      display: inline-block;
      margin-bottom: 40px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      color: var(--muted);
      text-decoration: none;
    }
    .xpp-back:hover { color: var(--black); }
    .xpp-back:focus-visible { outline: 2px solid var(--sienna); outline-offset: 4px; }

    .xpp-meta {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
      margin: 0 0 24px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      color: var(--muted);
    }
    .xpp-company { color: var(--black); font-weight: 400; }
    .xpp-meta span:not(.xpp-company)::before { content: '·'; margin-right: 10px; }

    .xpp-headline {
      margin: 0 0 14px;
      font-family: var(--font-display); font-stretch: var(--stretch-display);
      font-size: clamp(32px, 4.4vw, 52px);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.012em;
      color: var(--black);
    }

    .xpp-result {
      margin: 0 0 26px;
      padding-left: 18px;
      border-left: 2px solid var(--sienna);
      font-size: var(--fs-500);
      line-height: 1.55;
      color: var(--sienna);
    }

    .xpp-summary {
      margin: 0 0 40px;
      padding-bottom: 34px;
      border-bottom: 1px solid var(--border);
      font-size: var(--fs-400);
      line-height: 1.75;
      color: var(--text-body);
    }

    .xpp-also-wrap { margin: 0 0 40px; }
    .xpp-also-end { margin: 64px 0 0; padding-top: 24px; border-top: 1px solid var(--border); }
    .xpp-also-label {
      margin: 0 0 12px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      font-weight: 400;
      color: var(--muted);
    }
    .xpp-decision {
      margin: 0;
      max-width: 64ch;
      font-size: var(--fs-350);
      line-height: 1.7;
      color: var(--text-body);
    }
    .xpp-also { margin: 0; padding: 0; list-style: none; }
    .xpp-also li {
      position: relative;
      margin-bottom: 8px;
      padding-left: 16px;
      font-size: var(--fs-350);
      line-height: 1.7;
      color: var(--text-body);
    }
    .xpp-also li::before {
      content: '';
      position: absolute;
      left: 0; top: 0.66em;
      width: 6px; height: 1px;
      background: var(--muted);
    }

    .xpp-artifacts {
      display: grid;
      /* One column: print spreads are wide, and side by side they shrank to
         thumbnails with ragged rows. */
      grid-template-columns: 1fr;
      gap: 28px;
      margin: 0 0 40px;
    }
    .xpp-artifacts figure { margin: 0; }
    .xpp-artifacts img {
      width: 100%; height: auto; display: block;
      border: 1px solid var(--border);
    }
    .xpp-artifacts figcaption {
      margin-top: 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      color: var(--muted);
    }

    .xpp-unshipped {
      margin: 0 0 34px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      color: var(--muted);
    }

    /* An absence stated on purpose. Without this the page just looks like it is
       missing its images. */
    .xpp-nda {
      margin: 0 0 40px;
      padding: 20px 22px;
      border: 1px solid var(--border);
      border-left: 2px solid var(--muted);
    }
    .xpp-nda-label {
      margin: 0 0 8px;
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      color: var(--muted);
    }
    .xpp-nda-body {
      margin: 0;
      font-size: var(--fs-350);
      line-height: 1.7;
      color: var(--text-body);
    }

    /* Charts inside a case body. One hue for a single series, since length carries
       rank rather than color, and it rides var(--sienna) so it re-steps with the
       theme rather than being flipped automatically. Values are direct-labeled
       so the reading never depends on color alone. */
    .xpp-body :global(.dv-chart) {
      display: block;
      width: 100%;
      height: auto;
      margin: 6px 0 10px;
      overflow: visible;
    }
    .xpp-body :global(.dv-bar) { fill: var(--sienna); }
    .xpp-body :global(.dv-axis) { stroke: var(--border); stroke-width: 1; }
    .xpp-body :global(.dv-lbl) {
      fill: var(--muted);
      font-family: var(--font-mono);
      font-size: var(--fs-150);
    }
    .xpp-body :global(.dv-val) {
      fill: var(--black);
      font-family: var(--font-mono);
      font-size: var(--fs-150);
      font-weight: 700;
    }
    .xpp-body :global(p.dv-cap) {
      margin: 0 0 26px;
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      color: var(--muted);
    }

    .xpp-body { font-size: var(--fs-400); line-height: 1.8; color: var(--text-body); }
    .xpp-body :global(h2) {
      margin: 44px 0 14px;
      font-family: var(--font-display); font-stretch: var(--stretch-display);
      font-size: clamp(20px, 2.4vw, 26px);
      font-weight: 400;
      letter-spacing: -0.02em;
      color: var(--black);
    }
    .xpp-body :global(h2:first-child) { margin-top: 0; }
    .xpp-body :global(p) { margin: 0 0 16px; }
    .xpp-body :global(ul) { margin: 0 0 16px; padding-left: 20px; list-style: disc; }
    .xpp-body :global(li::marker) { color: var(--sienna); }
    .xpp-body :global(li) { margin-bottom: 8px; }
    .xpp-body :global(strong) { color: var(--black); font-weight: 600; }
    /* Historical screenshots inside a case body. Shown at their own aspect
       ratio, each linking to the full-size file since the originals are small. */
    .xpp-body :global(figure) { margin: 28px 0 32px; }
    .xpp-body :global(figure a) { display: block; text-decoration: none; }
    .xpp-body :global(figure img) {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--border);
      background: #fff;
    }
    /* Low-fi beside what shipped. */
    .xpp-body :global(.fig-pair) {
      display: grid;
      grid-template-columns: 2.1fr 1fr;
      gap: 16px;
      align-items: start;
      margin: 28px 0 32px;
    }
    .xpp-body :global(.fig-pair figure) { margin: 0; }
    @media (max-width: 600px) {
      .xpp-body :global(.fig-pair) { grid-template-columns: 1fr; }
    }
    /* The finding a decision answers, set above it so the reasoning reads at
       a glance without another paragraph of process. */
    .xpp-body :global(p.why) {
      margin: 30px 0 6px;
      font-style: italic;
      line-height: 1.6;
      color: var(--muted);
    }
    /* The phone capture has square white corners around a rounded device;
       clipping to the device's own radius removes them. */
    .xpp-body :global(img.fig-phone) {
      border: 0 !important;
      background: transparent !important;
      border-radius: 12% / 5.6%;
    }
    /* Two images side by side, equal width. */
    .xpp-body :global(.fig-two) {
      display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 28px 0 32px;
    }
    .xpp-body :global(.fig-two figure) { margin: 0; }
    @media (max-width: 600px) { .xpp-body :global(.fig-two) { grid-template-columns: 1fr; } }
    /* Screenshots that already carry their own browser window: no extra box. */
    .xpp-body :global(img.fig-plain) { border: 0 !important; background: transparent !important; }
    .xpp-body :global(img.fig-narrow) { max-width: 360px; margin: 0 auto; }
    /* Three small images side by side, each with its own caption. */
    .xpp-body :global(.fig-row) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 28px 0 32px;
    }
    .xpp-body :global(.fig-row figure) { margin: 0; }
    @media (max-width: 600px) {
      .xpp-body :global(.fig-row) { grid-template-columns: 1fr; }
    }
    .xpp-body :global(figcaption) {
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: var(--fs-100);
      line-height: 1.6;
      color: var(--muted);
    }
    .xpp-body :global(em) { color: var(--sienna); font-style: normal; }
    /* Underlined so a link never reads by color alone. */
    .xpp-body :global(a) {
      color: var(--sienna);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .xpp-body :global(a:hover) { color: var(--black); }
    .xpp-body :global(a:focus-visible) { outline: 2px solid var(--sienna); outline-offset: 3px; }

    /* Fixed section menu, left of the reading column. Wide screens only;
       phones read straight down. */
    .xpp-tools { display: flex; flex-wrap: wrap; gap: 6px; margin: -8px 0 28px; padding: 0; list-style: none; }
    .xpp-tools li { padding: 3px 10px; border: 1px solid var(--border); border-radius: 999px; font-size: 12px; line-height: 1.5; color: var(--muted); }
    .xpp-toc { display: none; }
    @media (min-width: 1080px) {
      .xpp-toc {
        display: block; position: fixed; top: 140px; z-index: 5;
        left: 24px; width: clamp(120px, calc(50vw - 390px - 64px), 170px);
      }
    }
    @media (min-width: 1300px) { .xpp-toc { left: calc(50% - 390px - 210px); } }
    .xpp-toc a {
      display: block; padding: 7px 0 7px 14px;
      border-left: 1px solid var(--border);
      font-size: var(--fs-150, 14px); line-height: 1.3;
      color: var(--muted); text-decoration: none;
      transition: color .2s, border-color .2s;
    }
    .xpp-toc a:hover { color: var(--black); }
    .xpp-toc a.on { color: var(--black); border-left-color: var(--sienna); }
    .xpp-toc a:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }
    .xpp-body :global(h2) { scroll-margin-top: 96px; }

    @media (max-width: 900px) {
      .xpp { padding: 32px 24px 72px; }
      .xpp-artifacts { grid-template-columns: 1fr; }
    }
  </style>

  {toc.length > 0 && (
    <nav class="xpp-toc" aria-label="Sections">
      {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
  )}
  <article class="xpp">
    <a href="/#work" class="xpp-back" id="overview">← Back to work</a>

    <h1 class="xpp-headline">{d.headline}</h1>
    <p class="xpp-meta">
      <span class="xpp-company">{d.company}</span>
      <span>{d.role}</span>
      <span>{d.location}</span>
    </p>
    {d.tools && d.tools.length > 0 && (
      <ul class="xpp-tools" aria-label="Tools and skills">
        {d.tools.map((t) => <li>{t}</li>)}
      </ul>
    )}
    {d.encrypted ? <EncryptedCase src={d.encrypted} /> : <>
    <p class="xpp-result">{d.result}</p>
    <p class="xpp-summary">{d.summary}</p>

    {d.decision && (
      <section class="xpp-also-wrap" aria-labelledby="decisionLabel">
        <h2 class="xpp-also-label" id="decisionLabel">A decision</h2>
        <p class="xpp-decision">{d.decision}</p>
      </section>
    )}


    {d.unshipped && (
      <p class="xpp-unshipped">Proposed. This design was never shipped</p>
    )}

    {d.nda && (!d.artifacts || d.artifacts.length === 0) && (
      <aside class="xpp-nda">
        <p class="xpp-nda-label">Internal work</p>
        <p class="xpp-nda-body">
          This was built for internal use and isn't mine to publish, so there are no
          screenshots here. The process and the outcome are described in full below,
          and I'm happy to walk through the rest in conversation.
        </p>
      </aside>
    )}

    {d.artifacts && d.artifacts.length > 0 && (
      <div class="xpp-artifacts">
        {d.artifacts.map((a) => (
          <figure>
            <img src={a.image} alt={a.caption ?? `${d.company} work sample`} loading="lazy" />
            {a.caption && <figcaption>{a.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <div class="xpp-body"><Content /></div>

    {/* Nov 20, 2026: moved below the case body so it doesn't break the story. */}
    {d.also && d.also.length > 0 && (
      <section class="xpp-also-wrap xpp-also-end" aria-labelledby="alsoLabel">
        <h2 class="xpp-also-label" id="alsoLabel">Also in this role</h2>
        <ul class="xpp-also">
          {d.also.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}
    </>}
  </article>

  <script>
    // Screenshot motion only runs while the screenshot is on screen.
    const shotIO = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('play', e.isIntersecting)), { threshold: 0.35 });
    document.querySelectorAll('.shot-scroll, .shot-zoom').forEach((el) => shotIO.observe(el));

    // Highlight the section in view in the side menu.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.xpp-toc a')];
    if (links.length) {
      const targets = links.map((a) => document.getElementById(a.hash.slice(1))).filter(Boolean) as HTMLElement[];
      const mark = (id: string) => links.forEach((a) => a.classList.toggle('on', a.hash === '#' + id));
      mark('overview');
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && mark(e.target.id)), { rootMargin: '-35% 0px -60% 0px' });
      targets.forEach((t) => io.observe(t));
    }
  </script>

</MainLayout>
