---
// This page does not go through MainLayout, so it does not inherit global.css,
// and that is where the self-hosted @font-face rules are reached from. Space
// Mono carries every small label on this page (the cue, the role, the location,
// the shutter's label, the hint, the email); without this import the only face
// the page declares is the Bricolage that comes from Google in the head, and
// all of that type silently falls back to whatever ui-monospace resolves to.
// It looks correct on a machine with the fonts installed locally, which is
// exactly why it has to be an import and not an assumption.
import MainLayout from '../../layouts/MainLayout.astro';
import TrackSelector from '../../components/TrackSelector.astro';
import styles from './about.module.css';
import { SITE_TITLE } from '../../consts';

const EMAIL = 'karen.dettmar@gmail.com';
const s = styles;

// Below the hero: the rest of the original About page, kept as it was.
const disciplines = [
  { name: 'UX Engineering',        desc: 'Research, interaction design, front-end build' },
  { name: 'Design Technology',     desc: 'Prototypes, interactive demos, browser tools' },
  { name: 'Interaction & Motion',  desc: 'How things open, respond and hold still, and',
    link: { href: '/system', text: 'the one behind this site' } },
];
const contact = [
  { label: 'Email',    value: 'karen.dettmar@gmail.com',   href: 'mailto:karen.dettmar@gmail.com', external: false },
  { label: 'LinkedIn', value: 'linkedin.com/in/kdettmar',  href: 'https://linkedin.com/in/kdettmar', external: true },
  { label: 'CV',       value: 'Download PDF',              href: '/Karen_Dettmar_CV.pdf', external: true },
];
const description = 'About Karen Dettmar, UX Engineer and Design Technologist in New York.';

---

<!-- Nov 2026 redesign: the darkroom hero is retired; About uses the shared
     layout. Bio, disciplines, contact and interests are the live copy. -->
<MainLayout title={`About · ${SITE_TITLE}`}>
  <div class={s['about-wrapper']}>
    <header class={s['about-header']}>
      <span class="page-eyebrow">About</span>
      <h1 class="page-title">Karen <em>Dettmar</em></h1>
    </header>

    <div class={s['bio']}>
      <p class={s['bio-lead']}>A UX engineer and design technologist in New York. I've spent my career where design meets code: building apps and redesigning sites that replace legacy systems, creating conference and meetup demos, and taking complex systems and making them easier for people to understand.</p>
      <p>I'm also a serial hobbyist in my free time. I love learning new skills and value personal growth while enriching my artistic craft. My current fixations are cooking and Muay Thai. There's only so much time in a day!</p>
    </div>

    <section class={s['section']} aria-labelledby="disciplinesLabel">
      <span class="page-eyebrow" id="disciplinesLabel">What I do</span>
      <ul class={s['row-list']}>
        {disciplines.map((d) => (
          <li class={s['row']}>
            <h2 class={s['row-key']}>{d.name}</h2>
            <p class={s['row-val']}>
              {d.desc}
              {d.link && <> <a href={d.link.href} class={s['inline-link']}>{d.link.text}</a></>}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class={s['section']} aria-labelledby="contactLabel" id="contact">
      <span class="page-eyebrow" id="contactLabel">Get in touch</span>
      <p class={s['availability']}>Available for UX Engineer and Design Technologist roles.</p>
      <ul class={s['row-list']}>
        {contact.map((c) => (
          <li>
            <a
              href={c.href}
              class={`${s['row']} ${s['row--link']}`}
              {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class={s['row-key']}>{c.label}</span>
              <span class={s['row-val']}>{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <TrackSelector bordered={true} prompt="Interests" />
</MainLayout>
