---
import MainLayout from '../layouts/MainLayout.astro';
import TrackSelector from '../components/TrackSelector.astro';
import styles from './about.module.css';
const s = styles;

// Label / value pairs, so the disciplines and the contact block share one
// rhythm instead of being a grid and a list that happen to sit on one page.
const disciplines = [
  { name: 'Design Engineering',    desc: 'React, Astro, TypeScript, APIs' },
  { name: 'Creative Technology',   desc: 'Interactive demos, prototypes, AI tools' },
  { name: 'Design Systems',        desc: 'Interaction, motion, and the one behind this site' },
  { name: 'Workshop Facilitation', desc: 'Community, education, technical storytelling' },
];

const contact = [
  { label: 'Email',    value: 'karen.dettmar@gmail.com',   href: 'mailto:karen.dettmar@gmail.com', external: false },
  { label: 'LinkedIn', value: 'linkedin.com/in/kdettmar',  href: 'https://linkedin.com/in/kdettmar', external: true },
  { label: 'CV',       value: 'Download PDF',              href: '/Karen_Dettmar_CV.pdf', external: true },
];
---

<MainLayout title="About · Karen Dettmar" theme="dark">
  <div class={s['about-wrapper']}>

    <!-- Header: emphasis is color, not italic, since Bricolage has no true italic -->
    <div class={`${s['about-header']} reveal`}>
      <span class="page-eyebrow">About</span>
      <h1 class="page-title" id="aboutTitle">Hi, I'm <em>Karen</em></h1>
    </div>

    <div class={`${s['bio']} reveal`}>
      <p class={s['bio-lead']}>
        A design engineer in New York. I spent a few years building internal tools, front-end systems, and interactive demos used by thousands of engineers, then went deep on fashion at Parsons and FIT. These days I build interactive tools that land where software meets something made by hand. How a thing opens, how it responds, and when it holds still are decisions, not defaults.
      </p>
      <p>
        I build with React, Astro, TypeScript, and the Claude API, and I still keep an industrial sewing machine in the corner of the room.
      </p>
    </div>

    <section class={`${s['section']} reveal`} aria-labelledby="disciplinesLabel">
      <span class="page-eyebrow" id="disciplinesLabel">What I do</span>
      <ul class={s['row-list']}>
        {disciplines.map((d) => (
          <li class={s['row']}>
            <h2 class={s['row-key']}>{d.name}</h2>
            <p class={s['row-val']}>{d.desc}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class={`${s['section']} reveal`} aria-labelledby="contactLabel">
      <span class="page-eyebrow" id="contactLabel">Get in touch</span>
      <ul class={s['row-list']}>
        {contact.map((c) => (
          <li>
            <a
              href={c.href}
              class={`${s['row']} ${s['row--link']}`}
              {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class={s['row-key']}>{c.label}</span>
              <span class={s['row-val']}>{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

  </div><!-- /about-wrapper -->

  <!-- WORK SPLIT: Fashion (studio subdomain) / Technology -->
  <TrackSelector bordered={true} prompt="Interests" />

  <!-- Easter egg: floating note (fixed, top-right) -->
  <div class={s['egg-note']} id="eggNote" aria-hidden="true">
    Still here? I'm probably making something.
  </div>

</MainLayout>

<script>
  // ── TRIPLE-CLICK EASTER EGG ──
  const eggNote = document.getElementById('eggNote');
  let eggClicks = 0;
  let eggLastT  = 0;
  let eggTimer: ReturnType<typeof setTimeout> | null = null;

  // The theme toggle it used to hang off is gone, so triple-click the name instead.
  const eggTarget = document.getElementById('aboutTitle');
  eggTarget?.addEventListener('click', () => {
    const now = Date.now();
    if (now - eggLastT > 800) eggClicks = 0;
    eggClicks++;
    eggLastT = now;

    if (eggClicks >= 3 && eggNote) {
      eggClicks = 0;
      localStorage.setItem('easter1', '1');
      if (eggTimer) clearTimeout(eggTimer);
      eggNote.removeAttribute('data-hiding');
      eggNote.setAttribute('data-visible', '');
      eggTimer = setTimeout(() => {
        eggNote.setAttribute('data-hiding', '');
        eggNote.addEventListener('animationend', () => {
          eggNote.removeAttribute('data-visible');
          eggNote.removeAttribute('data-hiding');
        }, { once: true });
      }, 4000);
    }
  });
</script>
