---
// The system behind the site (Nov 2026 redesign). Every color and ratio is
// read from src/styles/tokens.css at build time, so this page cannot drift
// from what ships: change a hex there and the swatch and its grade move too.
import MainLayout from '../layouts/MainLayout.astro';
import WorkCards from '../components/WorkCards.astro';
import { readTokens, tokensFor, byName, contrast, fmt, grade } from '../utils/tokens';

const blocks = readTokens('src/styles/tokens.css');
const light = tokensFor(blocks, ':root');
const dark = tokensFor(blocks, 'html[data-theme="dark"]');
const v = (t: typeof light, n: string) => byName(t, n)?.value ?? '';

// what each color does, in the order it matters
const ROLES = [
  { token: 'off-white', name: 'Ground' },
  { token: 'black', name: 'Ink', text: true },
  { token: 'sienna', name: 'Tomato', text: true },
  { token: 'muted', name: 'Muted', text: true },
  { token: 'warm-white', name: 'Surface' },
];

const themes = [
  { label: 'Linen', note: 'Light', t: light },
  { label: 'Night', note: 'Dark, a blue-grey, never black', t: dark },
].map(({ label, note, t }) => {
  const ground = v(t, 'off-white');
  return {
    label, note, ground, ink: v(t, 'black'), line: v(t, 'border'),
    swatches: ROLES.map((r) => {
      const value = v(t, r.token);
      const ratio = r.text ? contrast(value, ground) : null;
      return { ...r, value, ratio: ratio ? fmt(ratio) : null, grade: ratio ? grade(ratio) : null };
    }),
  };
});

const faces = [
  { name: 'Instrument Serif', role: 'Names and titles. Italic is the emphasis.', cls: 'f-serif', sample: 'Interfaces with <em>care</em>' },
  { name: 'Geist', role: 'Everything you read.', cls: 'f-body', sample: 'Prototyping, thoughtful interaction, and the small details that make something feel finished.' },
  { name: 'Geist Mono', role: 'Meta, labels, the clock.', cls: 'f-mono', sample: 'New York · Design Technologist' },
  { name: 'UnifrakturMaguntia', role: 'One word, once.', cls: 'f-black', sample: 'nerve' },
];

const easings = [
  { name: 'Snap', token: '--ease-snap', value: 'cubic-bezier(.34,1.56,.64,1)', use: 'Cards lifting, things that land' },
  { name: 'Slow', token: '--ease-slow', value: 'cubic-bezier(.22,1,.36,1)', use: 'Lines drawing, things that arrive' },
];

const parts = [
  { name: 'Work cards', where: 'WorkCards.astro', see: '/' },
  { name: 'Hover peek', where: 'HoverPeek.astro', see: '/projects/tech' },
  { name: 'Soap bubble', where: 'Bubble.astro · three.js', see: '/' },
  { name: 'Develop', where: 'develop.ts · canvas', see: '/about' },
  { name: 'Paper', where: 'cv.module.css · print', see: '/cv' },
];
---

<MainLayout title="System · Karen Dettmar">
  <div class="sys">
    <h1 class="sys-title">System</h1>
    <p class="lede">What this site is made of. Colors and ratios are read from the stylesheet when the site builds.</p>

    <section aria-labelledby="color">
      <h2 class="h" id="color">Color</h2>
      <div class="themes">
        {themes.map((th) => (
          <div class="theme" style={`background:${th.ground};color:${th.ink};border-color:${th.line}`}>
            <p class="theme-name">{th.label}<span>{th.note}</span></p>
            <ul class="swatches">
              {th.swatches.map((s) => (
                <li>
                  <span class="chip" style={`background:${s.value};border-color:${th.line}`}></span>
                  <span class="sw-name">{s.name}</span>
                  <span class="sw-meta">{s.ratio ? `${s.value} · ${s.ratio} ${s.grade}` : s.value}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="note">One accent. Tomato is the only color besides ink, and it gets brighter at night so it keeps its contrast.</p>
    </section>

    <section aria-labelledby="type">
      <h2 class="h" id="type">Type</h2>
      <ul class="faces">
        {faces.map((f) => (
          <li>
            <p class={`spec ${f.cls}`} set:html={f.sample} />
            <p class="face-meta"><span>{f.name}</span><span>{f.role}</span></p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="motion">
      <h2 class="h" id="motion">Motion</h2>
      <ul class="eases">
        {easings.map((e) => (
          <li style={`--e:var(${e.token})`}>
            <span class="track"><span class="dot"></span></span>
            <span class="ease-name">{e.name}</span>
            <span class="ease-meta">{e.use}</span>
          </li>
        ))}
      </ul>
      <p class="note">Hover a row to run it. With reduced motion on, nothing moves.</p>
    </section>

    <section aria-labelledby="parts">
      <h2 class="h" id="parts">Parts</h2>
      <WorkCards items={[
        { href: '/', title: 'A work card', left: 'Hover it', right: 'Live' },
        { href: '/projects/tech', title: 'Same card in the Lab', left: 'One component', right: 'Both pages' },
      ]} />
      <ul class="rows">
        {parts.map((p) => (
          <li>
            <a class="row-name" href={p.see}>{p.name}</a>
            <span class="row-what">{p.where}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <style>
    .sys { max-width: 1240px; margin: 0 auto; padding: 24px max(24px, env(safe-area-inset-right, 0px)) 120px max(24px, env(safe-area-inset-left, 0px)); }
    .sys-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(56px, 8vw, 112px); line-height: 1; letter-spacing: -.015em; margin: 0 0 16px; color: var(--black); }
    .lede { max-width: 46ch; color: var(--text-body); font-size: var(--fs-450); line-height: 1.55; margin: 0 0 24px; }
    section { margin-top: 88px; }
    .h { font-family: var(--font-display); font-weight: 400; font-size: clamp(32px, 4vw, 48px); line-height: 1; margin: 0 0 24px; color: var(--black); }
    .note { margin: 16px 0 0; color: var(--muted); font-size: var(--fs-350); max-width: 60ch; }

    /* color */
    .themes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .theme { border: 1px solid; padding: 24px; }
    .theme-name { font-family: var(--font-display); font-size: 32px; line-height: 1; margin: 0 0 24px; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .theme-name span, .sw-meta { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; opacity: .72; }
    .swatches { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .swatches li { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 14px; }
    .chip { width: 40px; height: 40px; border: 1px solid; }
    .sw-name { font-size: var(--fs-400); }

    /* type */
    .faces { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .faces li { padding: 28px 0 18px; border-bottom: 1px solid var(--border); }
    .spec { margin: 0 0 14px; color: var(--black); }
    .f-serif { font-family: var(--font-display); font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: var(--track-display); }
    .f-serif :global(em) { font-style: italic; color: var(--sienna); }
    .f-body { font-family: var(--font-body); font-size: var(--fs-600); line-height: 1.45; max-width: 40ch; }
    .f-mono { font-family: var(--font-mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
    .f-black { font-family: var(--font-black); font-size: clamp(56px, 8vw, 96px); line-height: 1; color: var(--sienna); }
    .face-meta, .row-what, .ease-meta { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
    .face-meta { margin: 0; display: flex; justify-content: space-between; gap: 16px; }
    .face-meta span:first-child { color: var(--black); }

    /* motion */
    .eases { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
    .eases li { display: grid; grid-template-columns: minmax(0, 2fr) 120px minmax(0, 1fr); align-items: center; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--border); }
    .track { position: relative; height: 1px; background: var(--border); }
    .dot { position: absolute; top: -7px; left: 0; width: 14px; height: 14px; border-radius: 50%; background: var(--sienna); transition: left .9s var(--e); }
    .eases li:hover .dot { left: calc(100% - 14px); }
    .ease-name { font-family: var(--font-display); font-size: 28px; line-height: 1; }

    /* parts */
    .rows { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--border); }
    .rows li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: baseline; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--border); }
    .row-name { font-family: var(--font-display); font-size: 28px; line-height: 1.1; color: var(--black); text-decoration: none; }
    .row-name:hover { font-style: italic; color: var(--sienna); }
    .row-name:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }

    @media (max-width: 760px) {
      .sys { padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
      .themes { grid-template-columns: 1fr; }
      .swatches li { grid-template-columns: 40px 1fr; }
      .sw-meta { grid-column: 2; }
      .eases li { grid-template-columns: 1fr auto; gap: 10px 16px; }
      .track { grid-column: 1 / -1; order: 3; }
      .face-meta { flex-direction: column; gap: 4px; }
    }
    @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
  </style>
</MainLayout>
