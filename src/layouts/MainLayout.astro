---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title: string;
  /** Which theme this page opens in when the visitor hasn't chosen one yet. */
  theme?: 'light' | 'dark';
}

const { title, theme = 'light' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content="Karen Dettmar, UX Engineer and Design Technologist, New York City">

  <!-- Link previews. Without og:image every share of this site, in Slack, in
       LinkedIn, in an email, renders as a blank card, which for a portfolio is
       the whole pitch thrown away. Absolute URLs, since crawlers do not resolve
       relative ones. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Karen Dettmar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Karen Dettmar, UX Engineer and Design Technologist in New York City." />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://karendettmar.com').href} />
  <meta property="og:image" content="https://karendettmar.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Karen Dettmar, UX Engineer and Design Technologist, with cyanotype botanicals" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content="Karen Dettmar, UX Engineer and Design Technologist in New York City." />
  <meta name="twitter:image" content="https://karendettmar.com/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Instrument Serif (display), UnifrakturMaguntia (the one rude word),
       Geist and Geist Mono (body and labels). -->
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=UnifrakturMaguntia&family=Geist:wght@400;500&family=Geist+Mono&display=swap" rel="stylesheet" />
  <!-- Theme: must run before body renders to prevent flash. A stored choice
       beats the page default; there is no visible toggle, so type light / dark.
       Also marks the document as scripted, which is what lets .reveal hide
       itself. Without this the scroll-in content stays visible rather than
       depending on a script that might never arrive. -->
  <!-- Pages that need something of their own in the head (a preload, a
       page-specific meta) put it here. -->
  <slot name="head" />

  <script is:inline define:vars={{ pageTheme: theme }}>
    (function () {
      document.documentElement.classList.add('js');
      // A choice made with the switch wins. Failing that, keep whatever theme
      // the visitor was already seeing this visit, so moving between pages
      // never flips it. The page's own default only decides the first page.
      var stored = null, carried = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      try { carried = sessionStorage.getItem('theme'); } catch (e) {}
      // No choice yet: follow the visitor's system setting (night browsing is
      // the reason dark mode exists). pageTheme is only a fallback.
      var sys = null;
      try {
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) sys = 'dark';
        else if (window.matchMedia('(prefers-color-scheme: light)').matches) sys = 'light';
      } catch (e) {}
      // No system signal at all: dark after sunset in New York, light after
      // sunrise. Worked out in UTC, so it is Karen's sky wherever the visitor is.
      function nycSky() {
        var now = new Date(), rad = Math.PI / 180, lat = 40.7128, lng = -74.006;
        var day = (Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - Date.UTC(now.getUTCFullYear(), 0, 0)) / 864e5;
        var g = 2 * Math.PI / 365 * (day - 1);
        var decl = 0.006918 - 0.399912 * Math.cos(g) + 0.070257 * Math.sin(g) - 0.006758 * Math.cos(2 * g) + 0.000907 * Math.sin(2 * g);
        var eqt = 229.18 * (0.000075 + 0.001868 * Math.cos(g) - 0.032077 * Math.sin(g) - 0.014615 * Math.cos(2 * g) - 0.040849 * Math.sin(2 * g));
        var ha = Math.acos(Math.cos(90.833 * rad) / (Math.cos(lat * rad) * Math.cos(decl)) - Math.tan(lat * rad) * Math.tan(decl)) / rad;
        var rise = 720 - 4 * (lng + ha) - eqt, set = 720 - 4 * (lng - ha) - eqt; // minutes after UTC midnight
        var m = now.getUTCHours() * 60 + now.getUTCMinutes();
        // NYC sunset falls after UTC midnight, so the daylight window wraps
        rise = (rise + 1440) % 1440; set = (set + 1440) % 1440;
        var light = rise < set ? (m >= rise && m < set) : (m >= rise || m < set);
        return light ? 'light' : 'dark';
      }
      var sky = null;
      if (!stored && !carried && !sys) { try { sky = nycSky(); } catch (e) {} }
      var t = stored || carried || sys || sky || pageTheme;
      document.documentElement.setAttribute('data-theme', t);
      try { sessionStorage.setItem('theme', t); } catch (e) {}
    })();
  </script>
  <!-- Arriving through the shutter. Module scripts are deferred, so by the time
       the iris could be drawn the page has already painted. This puts the
       ground up beforehand and hands off to the iris in one frame. A no-op on
       every other visit, since only the shutter sets the flag. The timeout is
       here rather than in the module on purpose: the cover has to lift even if
       the module never loads. -->
  <script is:inline>
    (function () {
      var on = false;
      // Read and spent in the same breath, so a flag can never survive onto a
      // page with no arrival to play and leave it sitting under the cover.
      try {
        on = sessionStorage.getItem('dk:shutter') === '1';
        if (on) sessionStorage.removeItem('dk:shutter');
      } catch (e) {}
      if (!on) return;
      window.__dkArrive = true;
      var r = document.documentElement;
      r.classList.add('dk-arriving');
      setTimeout(function () { r.classList.remove('dk-arriving'); }, 1500);
    })();
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    import { initThemeTyping } from '../scripts/theme';
    import { initPrintEgg } from '../scripts/print';
    import { initCopyEmail } from '../scripts/copyEmail';
    initThemeTyping();
    initPrintEgg();
    initCopyEmail();

    // ── SCROLL REVEAL ──
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    reveals.forEach(el => observer.observe(el));
  </script>
</body>
</html>
