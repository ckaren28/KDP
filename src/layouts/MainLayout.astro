---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

interface Props {
  title: string;
  /** Which theme this page opens in when the visitor hasn't chosen one yet. */
  theme?: 'light' | 'dark';
}

const { title, theme = 'light' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content="Karen Dettmar, Creative Technologist, New York City">

  <!-- Link previews. Without og:image every share of this site, in Slack, in
       LinkedIn, in an email, renders as a blank card, which for a portfolio is
       the whole pitch thrown away. Absolute URLs, since crawlers do not resolve
       relative ones. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Karen Dettmar" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content="Karen Dettmar, Creative Technologist and Design Engineer in New York City." />
  <meta property="og:url" content={new URL(Astro.url.pathname, 'https://karendettmar.com').href} />
  <meta property="og:image" content="https://karendettmar.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Karen Dettmar, Creative Technologist and Design Engineer, with cyanotype botanicals" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content="Karen Dettmar, Creative Technologist and Design Engineer in New York City." />
  <meta name="twitter:image" content="https://karendettmar.com/og-image.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Only Bricolage comes from Google now: its opsz axis has to stay live,
       and a variable font is what delivers that. Instrument Sans and Space
       Mono are self-hosted static instances (see styles/fonts.css), and both
       ship real italics, so the browser never synthesizes a slant. Bricolage
       has no italic at all, so display type carries emphasis with color
       rather than a fake oblique. -->
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap" rel="stylesheet" />
  <!-- Theme: must run before body renders to prevent flash. A stored choice
       beats the page default; there is no visible toggle, so type light / dark.
       Also marks the document as scripted, which is what lets .reveal hide
       itself. Without this the scroll-in content stays visible rather than
       depending on a script that might never arrive. -->
  <!-- Pages that need something of their own in the head (a preload, a
       page-specific meta) put it here. -->
  <slot name="head" />

  <script is:inline define:vars={{ pageTheme: theme }}>
    (function () {
      document.documentElement.classList.add('js');
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || pageTheme);
    })();
  </script>
  <!-- Arriving through the shutter. Module scripts are deferred, so by the time
       the iris could be drawn the page has already painted. This puts the
       ground up beforehand and hands off to the iris in one frame. A no-op on
       every other visit, since only the shutter sets the flag. The timeout is
       here rather than in the module on purpose: the cover has to lift even if
       the module never loads. -->
  <script is:inline>
    (function () {
      var on = false;
      // Read and spent in the same breath, so a flag can never survive onto a
      // page with no arrival to play and leave it sitting under the cover.
      try {
        on = sessionStorage.getItem('dk:shutter') === '1';
        if (on) sessionStorage.removeItem('dk:shutter');
      } catch (e) {}
      if (!on) return;
      window.__dkArrive = true;
      var r = document.documentElement;
      r.classList.add('dk-arriving');
      setTimeout(function () { r.classList.remove('dk-arriving'); }, 1500);
    })();
  </script>
</head>
<body>
  <!-- CURSOR -->
  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    import { initThemeTyping } from '../scripts/theme';
    import { initPrintEgg } from '../scripts/print';
    import { initCopyEmail } from '../scripts/copyEmail';
    initThemeTyping();
    initPrintEgg();
    initCopyEmail();

    // ── CUSTOM CURSOR ──
    // Nothing here gives up the system cursor until both elements resolve and
    // the reduced-motion check passes. `cursor-live` is what unlocks
    // `cursor: none` in global.css, so a module that never loads, or a visitor
    // who asked for less motion, simply keeps the real pointer.
    const cursor = document.getElementById('cursor') as HTMLElement | null;
    const ring = document.getElementById('cursorRing') as HTMLElement | null;
    const stillPointer = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || window.matchMedia('(pointer: coarse)').matches;

    if (cursor && ring && !stillPointer) {
      document.documentElement.classList.add('cursor-live');

      let ringX = 0, ringY = 0, curX = 0, curY = 0;

      document.addEventListener('mousemove', (e) => {
        curX = e.clientX; curY = e.clientY;
        cursor.style.left = curX + 'px';
        cursor.style.top = curY + 'px';
      });

      const animateRing = () => {
        ringX += (curX - ringX) * 0.12;
        ringY += (curY - ringY) * 0.12;
        ring.style.left = ringX + 'px';
        ring.style.top = ringY + 'px';
        requestAnimationFrame(animateRing);
      };
      animateRing();
    }

    // ── SCROLL REVEAL ──
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    reveals.forEach(el => observer.observe(el));
  </script>
</body>
</html>
