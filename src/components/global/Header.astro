---
import ThemeSwitch from './ThemeSwitch.astro';
---

<!-- Studio lives on the about page (via TrackSelector) and GitHub lives in the
     footer. Neither belongs in the primary menu. This nav is the site's own
     pages only. -->
<header>
  <!-- Initials, not the full name. It's the only route home, so it carries an
       accessible name that isn't just two letters read aloud. -->
  <a href="/" class="nav-logo" aria-label="Karen Dettmar, home">KD</a>
  <nav aria-label="Primary">
    <ul class="nav-links">
      <li><a href="/projects">Work</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/cv">CV</a></li>
      <li class="nav-switch"><ThemeSwitch /></li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 48px;
    background-color: var(--off-white);
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, border-color 0.35s ease;
  }

  /* Set to match the landing page's name exactly (Bricolage Grotesque 600 at
     opsz 96) so the initials read as the same mark, just smaller.
     19px is deliberately off the type ladder: it is pinned to .dk-who in
     darkroom.css, the landing page's own closed system, which does not load
     these tokens. Change one and change the other. */
  .nav-logo {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    font-variation-settings: 'opsz' 96;
    letter-spacing: -0.028em;
    color: var(--black);
    text-decoration: none;
  }

  nav { margin-left: auto; }

  .nav-links {
    display: flex;
    gap: 26px;
    list-style: none;
    align-items: center;
  }

  /* Mono, uppercase and tracked, matching .page-eyebrow and the landing page's
     own nav. Uppercase widens the run, so every breakpoint below steps down a
     size: the nav wrapping is a real failure, not a cosmetic one, since it
     splits the mark off the menu and eats two rows on a short phone. */
  .nav-links a {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    font-weight: 400;
    color: var(--text-body);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--black); }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -3px; left: 0;
    width: 0; height: 1px;
    background: var(--sienna);
    transition: width 0.3s ease;
  }
  .nav-links a:hover::after { width: 100%; }

  .nav-switch { display: flex; align-items: center; color: var(--black); }

  .nav-links a:focus-visible,
  .nav-logo:focus-visible {
    outline: 2px solid var(--sienna);
    outline-offset: 5px;
    border-radius: 2px;
  }

  /* The wordmark is the only route back to the landing page, so it never
     hides. It shrinks instead. Hiding it stranded mobile visitors on
     whatever page they landed on. */
  @media (max-width: 900px) {
    header { padding: 16px 24px; gap: 14px; }
    .nav-logo { font-size: var(--fs-550); }
    .nav-links { gap: 16px; }
    .nav-links a { font-size: var(--fs-150); }
  }
  @media (max-width: 560px) {
    header { padding: 13px 16px; gap: 10px; }
    .nav-logo { font-size: var(--fs-500); }
    .nav-links { gap: 13px; }
    .nav-links a { font-size: var(--fs-150); letter-spacing: 0.1em; }
  }
  @media (max-width: 380px) {
    header { padding: 12px 13px; gap: 8px; }
    .nav-logo { font-size: var(--fs-450); }
    .nav-links { gap: 11px; }
    .nav-links a { font-size: var(--fs-100); letter-spacing: 0.08em; }
  }
</style>
