---
// Nov 2026 redesign: name in the display serif and a
// plain-text Dark / Light switch. Below 640px the links fold into a Menu.
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/projects/tech', label: 'Lab' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
];
---

<header class="hd">
  <a href="/" class="hd-name" aria-label="Karen Dettmar, home">Karen Dettmar</a>
  <button type="button" class="hd-menu" id="hdMenu" aria-expanded="false" aria-controls="hdNav">Menu</button>
  <nav aria-label="Primary" id="hdNav">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><button type="button" class="hd-theme" id="hdTheme">Dark</button></li>
    </ul>
  </nav>
</header>

<script>
  import { applyTheme, currentTheme } from '../../scripts/theme';

  const themeBtn = document.getElementById('hdTheme');
  if (themeBtn) {
    const label = () => { themeBtn.textContent = currentTheme() === 'dark' ? 'Light' : 'Dark'; };
    label();
    themeBtn.addEventListener('click', () => { applyTheme(currentTheme() === 'dark' ? 'light' : 'dark'); });
    window.addEventListener('themechange', label);
  }

  const menu = document.getElementById('hdMenu');
  const nav = document.getElementById('hdNav');
  if (menu && nav) {
    const set = (open: boolean) => {
      nav.classList.toggle('open', open);
      menu.setAttribute('aria-expanded', String(open));
      menu.textContent = open ? 'Close' : 'Menu';
    };
    menu.addEventListener('click', () => set(!nav.classList.contains('open')));
    nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  }
</script>

<style>
  .hd {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 100;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 18px max(24px, env(safe-area-inset-right, 0px)) 14px max(24px, env(safe-area-inset-left, 0px));
    background: var(--off-white);
    transition: background-color .5s var(--ease-slow);
  }
  .hd-name {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1;
    color: var(--black);
    text-decoration: none;
  }
  .hd-name:hover { font-style: italic; }
  .hd nav a, .hd-theme, .hd-menu {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .hd ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; align-items: baseline; }
  .hd nav a { color: var(--black); text-decoration: none; }
  .hd nav a:hover, .hd-theme:hover { color: var(--sienna); }
  .hd-theme, .hd-menu { appearance: none; border: 0; background: none; padding: 0; color: var(--black); cursor: pointer; }
  .hd-menu { display: none; }
  .hd a:focus-visible, .hd button:focus-visible { outline: 2px solid var(--sienna); outline-offset: 4px; }

  @media (max-width: 640px) {
    .hd { align-items: center; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
    .hd-menu { display: inline; }
    .hd nav { display: none; position: absolute; right: max(16px, env(safe-area-inset-right, 0px)); top: calc(100% + 4px); padding: 18px 22px; background: var(--off-white); border: 1px solid var(--black); }
    .hd nav.open { display: block; }
    .hd ul { flex-direction: column; gap: 16px; }
  }
</style>
