---
import ThemeSwitch from './ThemeSwitch.astro';

const STUDIO = 'https://studio.karendettmar.com';
const GITHUB = 'https://github.com/ckaren28';
---

<header>
  <a href="/" class="nav-logo">Karen Dettmar</a>
  <nav aria-label="Primary">
    <ul class="nav-links">
      <li><a href="/projects">Work</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/cv">CV</a></li>
      <li><a href={STUDIO}>Studio ↗</a></li>
      <li>
        <a href={GITHUB} class="nav-gh" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub
        </a>
      </li>
      <li class="nav-switch"><ThemeSwitch /></li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 48px;
    background-color: var(--off-white);
    border-bottom: 1px solid transparent;
    transition: background-color 0.35s ease, border-color 0.35s ease;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--black);
    text-decoration: none;
  }

  nav { margin-left: auto; }

  .nav-links {
    display: flex;
    gap: 26px;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-body);
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
  }
  .nav-links a:hover { color: var(--black); }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -3px; left: 0;
    width: 0; height: 1px;
    background: var(--sienna);
    transition: width 0.3s ease;
  }
  .nav-links a:hover::after { width: 100%; }

  /* GitHub reads as a first-class destination, not a footnote */
  .nav-links .nav-gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 600;
    color: var(--black);
  }
  .nav-links .nav-gh svg { width: 15px; height: 15px; fill: currentColor; }
  .nav-links .nav-gh:hover { color: var(--sienna); }

  .nav-switch { display: flex; align-items: center; color: var(--black); }

  .nav-links a:focus-visible,
  .nav-logo:focus-visible {
    outline: 2px solid var(--sienna);
    outline-offset: 5px;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    header { padding: 16px 24px; gap: 14px; }
    .nav-logo { display: none; }
    .nav-links { gap: 16px; }
    .nav-links a { font-size: 13px; }
  }
  @media (max-width: 560px) {
    .nav-links { gap: 12px; }
    .nav-links a { font-size: 12px; }
    .nav-links .nav-gh span { display: none; }
  }
</style>
