---
/**
 * Theme toggle.
 *
 * A switch, not an icon: "on" is the darkroom (dark, the default), "off" turns
 * the room lights on. The knob is the safelight, lit in the accent when dark
 * and an empty ring when light. Hairline track to match the site's rules.
 * Typing "light" / "dark" still works; this just makes it discoverable.
 */
---

<button class="tg" id="themeSwitch" type="button" role="switch" aria-checked="true" title="Switch to light">
  <span class="visually-hidden">Dark mode</span>
  <span class="tg-track" aria-hidden="true"><span class="tg-knob"></span></span>
</button>

<style>
  .tg {
    background: none;
    border: none;
    padding: 4px;
    line-height: 0;
    color: inherit;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .tg-track {
    position: relative;
    width: 34px; height: 18px;
    border: 1px solid currentColor;
    border-radius: 999px;
    opacity: 0.8;
    transition: opacity 0.25s ease;
  }
  .tg:hover .tg-track { opacity: 1; }
  .tg-knob {
    position: absolute;
    top: 50%; left: 3px;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--accent-loud);
    box-shadow: 0 0 8px var(--accent-loud);
    transform: translate(0, -50%);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1), background-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* Light: the lamp is out, knob slides over as an empty ring */
  :global(html[data-theme='light']) .tg-knob {
    transform: translate(16px, -50%);
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  .tg:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-knob, .tg-track { transition: none; }
  }
</style>

<script>
  import { applyTheme, currentTheme } from '../../scripts/theme';

  const btn = document.getElementById('themeSwitch');

  function sync() {
    const t = currentTheme();
    btn?.setAttribute('aria-checked', t === 'dark' ? 'true' : 'false');
    btn?.setAttribute('title', t === 'light' ? 'Switch to dark' : 'Switch to light');
  }

  btn?.addEventListener('click', () => {
    applyTheme(currentTheme() === 'light' ? 'dark' : 'light');
  });
  window.addEventListener('themechange', sync);
  sync();
</script>
