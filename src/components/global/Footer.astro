---
const year = new Date().getFullYear();
const GITHUB = 'https://github.com/ckaren28';
---

<footer>
  <p>© {year} Karen Dettmar</p>
  <!-- GitHub lives here, not in the primary nav -->
  <a href={GITHUB} class="footer-gh" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
    GitHub
  </a>
  <p>Creative Technologist · New York City</p>
</footer>

<style>
  footer {
    padding: 28px 48px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  footer p {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .footer-gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-body);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-gh svg { width: 13px; height: 13px; fill: currentColor; }
  .footer-gh:hover { color: var(--black); }
  .footer-gh:focus-visible {
    outline: 2px solid var(--sienna);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 900px) {
    footer {
      padding: 24px 28px;
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
