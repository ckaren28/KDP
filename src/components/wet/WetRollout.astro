---
// WET case study, Nov 20 2026: how the travel app shipped. Steps light up in
// order while in view; the legacy system is crossed out at the end.
---
<div class="wro" aria-label="Rollout: IT testing, a pilot in a couple of departments, company-wide rollout, legacy system retired">
  <ol>
    <li><b>IT testing</b><span>WET's IT team tested it first</span></li>
    <li><b>Pilot</b><span>A couple of departments</span></li>
    <li><b>Company-wide</b><span>Every employee who travels</span></li>
    <li class="wro-old"><b>Legacy system</b><span>Retired</span></li>
  </ol>
</div>

<style>
  .wro { background: #fff; color: #1d1d1f; font: 13px/1.4 Helvetica, Arial, sans-serif; border-radius: 10px; padding: 22px; box-shadow: 0 22px 48px -24px rgba(0,0,0,.45); }
  .wro ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .wro li { position: relative; padding: 14px 12px 12px; border: 1px solid #e2e2e6; border-top: 3px solid #e2e2e6; border-radius: 6px; transition: border-color .4s, background .4s; }
  .wro b { display: block; margin-bottom: 3px; }
  .wro span { display: block; font-size: 11.5px; color: #5b5b60; }
  .wro li.on { border-top-color: #d93a32; }
  .wro li.wro-old.on { background: #f7f7f8; border-top-color: #9a9aa0; }
  .wro li.wro-old.on b { text-decoration: line-through; text-decoration-color: #d93a32; text-decoration-thickness: 2px; color: #6b6b70; }
  @media (max-width: 600px) { .wro ol { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .wro li { transition: none; } }
</style>

<script is:inline>
  document.querySelectorAll('.wro').forEach((root) => {
    if (root.dataset.bound) return; root.dataset.bound = '1';
    const steps = [...root.querySelectorAll('li')];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { steps.forEach((s) => s.classList.add('on')); return; }
    let timer = 0;
    const run = () => { steps.forEach((s) => s.classList.remove('on')); steps.forEach((s, i) => setTimeout(() => s.classList.add('on'), 400 + i * 700)); };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !timer) { run(); timer = window.setInterval(run, 6000); }
      else if (!e.isIntersecting && timer) { clearInterval(timer); timer = 0; }
    }, { threshold: 0.4 }).observe(root);
  });
</script>
