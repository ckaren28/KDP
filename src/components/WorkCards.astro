---
// The ruled card grid used for work on the homepage and projects in the Lab,
// so both pages read as one site. Each card is a title and one meta line
// (left / right). Hovering flips the card to ink, sketches a fresh underline
// and, with <HoverPeek /> on the page, shows a small preview.
export interface WorkItem { href: string; title: string; left: string; right: string; peek?: string; external?: boolean }
interface Props { items: WorkItem[] }
const { items } = Astro.props;
---

<div class="cards">
  {items.map((w) => (
    <a class="card" href={w.href} data-peek={w.peek} {...(w.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
      <span class="t">{w.title}<svg viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2,10 L198,10" /></svg></span>
      <span class="r"><span>{w.left}</span><b>{w.right}</b></span>
    </a>
  ))}
</div>

<script>
  // A new hand-sketched underline on every hover: out and back, pen never lifts.
  const jit = (n: number) => (Math.random() * 2 - 1) * n;
  const sketch = () => {
    const y0 = 9 + jit(2), slope = jit(4);
    let d = `M${(2 + jit(2)).toFixed(1)},${(y0 + jit(1.5)).toFixed(1)}`;
    for (let x = 14; x <= 198; x += 10 + Math.random() * 8) d += ` L${x.toFixed(1)},${(y0 + slope * x / 200 + jit(1.7)).toFixed(1)}`;
    const back = 3 + jit(1.2), stop = 40 + Math.random() * 90;
    for (let x = 194; x >= stop; x -= 12 + Math.random() * 10) d += ` L${x.toFixed(1)},${(y0 + back + slope * x / 200 + jit(1.9)).toFixed(1)}`;
    return d;
  };
  document.querySelectorAll<SVGPathElement>('.card .t path').forEach((p) => {
    p.setAttribute('d', sketch());
    p.closest('.card')?.addEventListener('mouseenter', () => p.setAttribute('d', sketch()));
  });
  // Phones have no hover: draw each card's line as it scrolls into view.
  if (matchMedia('(hover: none)').matches) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('seen'); io.unobserve(e.target); }
    }), { threshold: 0.6 });
    document.querySelectorAll('.card').forEach((c) => io.observe(c));
  }
</script>

<style>
  .cards { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .card {
    grid-column: span 2;
    position: relative; display: flex; flex-direction: column; gap: 28px; min-width: 0; min-height: 150px;
    padding: 18px 20px 16px;
    border: 1px solid var(--border);
    color: var(--black); text-decoration: none; background: transparent;
    transition: transform .45s var(--ease-snap), background .25s, color .25s, border-color .25s;
  }
  .card:nth-child(-n+2) { grid-column: span 3; }
  .card:nth-child(-n+2) .t { font-size: 40px; }
  .t { position: relative; align-self: flex-start; font-family: var(--font-display); font-size: 30px; line-height: 1.02; text-wrap: balance; }
  .t svg { position: absolute; left: -2%; bottom: -.3em; width: 104%; height: .5em; overflow: visible; pointer-events: none; }
  .t path { fill: none; stroke: var(--accent-loud); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset .55s var(--ease-slow); }
  .r { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); transition: color .25s; }
  .r b { font-weight: 400; color: var(--sienna); text-align: right; }
  .card:hover, .card:focus-visible { background: var(--black); color: var(--off-white); border-color: var(--black); transform: translateY(-4px) rotate(-.7deg); }
  .card:hover .t, .card:focus-visible .t { font-style: italic; }
  .card:hover .t path, .card:focus-visible .t path, :global(.card.seen) .t path { stroke-dashoffset: 0; }
  .card:hover .r, .card:focus-visible .r { color: var(--off-white); }
  .card:hover .r b, .card:focus-visible .r b { color: var(--tone2-flip); }
  .card:hover .t path, .card:focus-visible .t path { stroke: var(--tone2-flip); }
  .card:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }

  @media (max-width: 980px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card, .card:nth-child(-n+2) { grid-column: span 1; }
    .card:first-child { grid-column: span 2; }
    .card:nth-child(2) .t { font-size: 30px; }
    /* exactly two cards: side by side */
    .cards:has(> .card:nth-child(2):last-child) .card:first-child { grid-column: span 1; }
  }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
    .card, .card:first-child, .cards:has(> .card:nth-child(2):last-child) .card:first-child { grid-column: auto; }
    .card:first-child .t { font-size: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .card, .t path { transition: none; } }
</style>
