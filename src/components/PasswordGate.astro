---
// `slug` is still accepted so callers don't have to change, but access is now
// site-wide rather than per-project, so one password and one cookie.
interface Props {
  slug?: string;
  // What the gate is in front of, e.g. "project" or "page".
  noun?: string;
}
const { noun = 'project' } = Astro.props;
---

<div id="pw-gate">
  <p class="pw-eyebrow">Password protected</p>
  <p class="pw-label">Enter the password to read this {noun}. It's remembered for a week.</p>
  <form id="pw-form">
    <input
      id="pw-input"
      type="password"
      placeholder="Password"
      autocomplete="current-password"
      aria-label="Password"
    />
    <button type="submit">Enter</button>
    <p id="pw-error" class="pw-error" aria-live="polite"></p>
  </form>
</div>

<style>
  /* Same treatment as the internal-work note on the experience pages: a
     hairline box with a left rule, so a withheld page reads as a deliberate
     state rather than a login screen dropped in from elsewhere. Every color is
     a theme token, so it follows light and dark with the rest of the page. */
  #pw-gate {
    max-width: 560px;
    margin: 0 0 40px;
    padding: 22px 24px 18px;
    border: 1px solid var(--border);
    border-left: 2px solid var(--sienna);
  }

  .pw-eyebrow {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-150);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pw-label {
    margin: 0 0 18px;
    font-family: var(--font-body);
    font-size: var(--fs-350);
    line-height: 1.7;
    color: var(--text-body);
  }

  #pw-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #pw-input {
    flex: 1 1 200px;
    min-width: 0;
    padding: 10px 12px;
    font-family: var(--font-body);
    font-size: var(--fs-300);
    color: var(--black);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0;
    outline: none;
    transition: border-color 0.2s;
  }
  #pw-input::placeholder { color: var(--muted); }
  #pw-input:focus { border-color: var(--sienna); }
  #pw-input:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }

  button[type="submit"] {
    flex: 0 0 auto;
    padding: 10px 22px;
    font-family: var(--font-mono);
    font-size: var(--fs-150);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--off-white);
    background: var(--black);
    border: 1px solid var(--black);
    border-radius: 0;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  button[type="submit"]:hover { background: var(--sienna); border-color: var(--sienna); }
  button[type="submit"]:focus-visible { outline: 2px solid var(--sienna); outline-offset: 3px; }

  .pw-error {
    flex-basis: 100%;
    margin: 0;
    min-height: 1.4em;
    font-family: var(--font-body);
    font-size: var(--fs-300);
    color: var(--sienna);
  }
  .pw-error:empty { min-height: 0; }
</style>

<script>
  // One cookie for the whole site, not one per project: there is a single
  // GATE_PASSWORD, so entering it once should open everything. Seven days,
  // path=/ so it carries across every project page.
  const COOKIE = 'kd_gate';
  const WEEK = 60 * 60 * 24 * 7;

  function hasPass() {
    return document.cookie.split('; ').some((c) => c.startsWith(COOKIE + '=granted'));
  }

  function remember() {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `${COOKIE}=granted; Max-Age=${WEEK}; Path=/; SameSite=Lax${secure}`;
  }

  function revealContent() {
    const gate = document.getElementById('pw-gate');
    const content = document.getElementById('gated-content');
    if (gate) gate.style.display = 'none';
    if (content) content.style.display = '';
  }

  if (hasPass()) {
    revealContent();
  }

  const form = document.getElementById('pw-form');
  const input = document.getElementById('pw-input');
  const errorEl = document.getElementById('pw-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.textContent = '';

      const password = input?.value ?? '';
      if (!password) return;

      try {
        const res = await fetch('/.netlify/functions/verify-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json().catch(() => ({}));

        if (data.ok) {
          remember();
          revealContent();
        } else if (res.status === 404) {
          // No function here at all. That is `astro dev` or `astro preview`,
          // which serve pages but don't run Netlify functions. It used to fall
          // into the branch below and claim the password wasn't set.
          if (errorEl) {
            errorEl.textContent =
              "The password check isn't running here. Locally, use netlify dev.";
          }
        } else if (!res.ok) {
          // A missing GATE_PASSWORD makes the function 500. Without this branch
          // that looked identical to a wrong password, so a misconfigured gate
          // rejected the *correct* password forever with no way to tell why.
          if (errorEl) {
            errorEl.textContent =
              data.error || 'Something went wrong checking the password. Please try again.';
          }
        } else {
          if (errorEl) errorEl.textContent = 'Incorrect password.';
          if (input) input.value = '';
        }
      } catch {
        if (errorEl) errorEl.textContent = 'Something went wrong. Please try again.';
      }
    });
  }
</script>
