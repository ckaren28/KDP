---
// `slug` is still accepted so callers don't have to change, but access is now
// site-wide rather than per-project — one password, one cookie.
interface Props {
  slug?: string;
}
---

<div id="pw-gate">
  <p class="pw-label">This project is password protected.</p>
  <p class="pw-note">Enter once and you're set for a week.</p>
  <form id="pw-form">
    <input
      id="pw-input"
      type="password"
      placeholder="Password"
      autocomplete="current-password"
      aria-label="Password"
    />
    <button type="submit">Enter</button>
    <p id="pw-error" class="pw-error" aria-live="polite"></p>
  </form>
</div>

<style>
  #pw-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 1rem;
  }

  .pw-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }

  .pw-note {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--muted);
    opacity: 0.75;
    margin: -0.5rem 0 0;
  }

  #pw-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 280px;
  }

  #pw-input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--black);
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: 2px;
    outline: none;
    box-sizing: border-box;
  }

  #pw-input:focus {
    border-color: var(--muted);
  }

  button[type="submit"] {
    width: 100%;
    padding: 0.6rem 1.2rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--off-white);
    background: var(--black);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.15s;
  }

  button[type="submit"]:hover {
    background: var(--sienna);
  }

  .pw-error {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--sienna);
    margin: 0;
    min-height: 1.2em;
  }
</style>

<script>
  // One cookie for the whole site, not one per project: there is a single
  // GATE_PASSWORD, so entering it once should open everything. Seven days,
  // path=/ so it carries across every project page.
  const COOKIE = 'kd_gate';
  const WEEK = 60 * 60 * 24 * 7;

  function hasPass() {
    return document.cookie.split('; ').some((c) => c.startsWith(COOKIE + '=granted'));
  }

  function remember() {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `${COOKIE}=granted; Max-Age=${WEEK}; Path=/; SameSite=Lax${secure}`;
  }

  function revealContent() {
    const gate = document.getElementById('pw-gate');
    const content = document.getElementById('gated-content');
    if (gate) gate.style.display = 'none';
    if (content) content.style.display = '';
  }

  if (hasPass()) {
    revealContent();
  }

  const form = document.getElementById('pw-form');
  const input = document.getElementById('pw-input');
  const errorEl = document.getElementById('pw-error');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.textContent = '';

      const password = input?.value ?? '';
      if (!password) return;

      try {
        const res = await fetch('/.netlify/functions/verify-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json().catch(() => ({}));

        if (data.ok) {
          remember();
          revealContent();
        } else if (!res.ok) {
          // A missing GATE_PASSWORD makes the function 500. Without this branch
          // that looked identical to a wrong password, so a misconfigured gate
          // rejected the *correct* password forever with no way to tell why.
          if (errorEl) {
            errorEl.textContent =
              data.error || 'The password gate is not configured. Set GATE_PASSWORD in Netlify.';
          }
        } else {
          if (errorEl) errorEl.textContent = 'Incorrect password.';
          if (input) input.value = '';
        }
      } catch {
        if (errorEl) errorEl.textContent = 'Something went wrong. Please try again.';
      }
    });
  }
</script>
