---
// Pixomondo case study, Nov 20 2026: the site footer's studio clocks, which
// Karen built, running live (one per studio, local time). Styled from her
// screenshot of the footer (footer-clocks.png).
const studios = [
  ['LAX', 'America/Los_Angeles'], ['YVR', 'America/Vancouver'], ['YTO', 'America/Toronto'],
  ['FRA', 'Europe/Berlin'], ['STR', 'Europe/Berlin'], ['SHA', 'Asia/Shanghai'], ['PEK', 'Asia/Shanghai'],
];
---
<div class="pxc" aria-label="Pixomondo footer: a live clock for each studio">
  <p class="pxc-logo">PIXOMONDO</p>
  <p class="pxc-tag">With the best creative talent from all over the world, there is always something new in development.</p>
  <ul class="pxc-row">
    {studios.map(([code, tz]) => (
      <li data-tz={tz}>
        <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" /><line class="h" x1="50" y1="50" x2="50" y2="28" /><line class="m" x1="50" y1="50" x2="50" y2="16" /></svg>
        <span>{code}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .pxc { background: #3d4250; color: #fff; border-radius: 10px; padding: 34px 20px 30px; text-align: center; font-family: Roboto, 'Helvetica Neue', Arial, sans-serif; box-shadow: 0 22px 48px -24px rgba(0,0,0,.45); }
  .pxc-logo { margin: 0 0 10px !important; font: 900 22px/1 'Arial Black', Helvetica, Arial, sans-serif; letter-spacing: .02em; }
  .pxc-tag { margin: 0 auto 22px !important; text-align: center; max-width: 46ch; font-size: 12.5px; line-height: 1.5; color: #9aa1b2; }
  .pxc-row { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px 16px; margin: 0 !important; padding: 0 !important; list-style: none !important; }
  .pxc-row li { width: 56px; margin: 0 !important; list-style: none !important; }
  .pxc-row li::marker { content: ''; }
  .pxc-row svg { width: 56px; height: 56px; display: block; }
  .pxc-row circle { fill: #e8ecf8; stroke: #5b78d6; stroke-width: 2; }
  .pxc-row line { stroke: #111; stroke-linecap: round; }
  .pxc-row .h { stroke-width: 4; } .pxc-row .m { stroke-width: 3; }
  .pxc-row span { display: block; margin-top: 6px; font-size: 13px; color: #9aa1b2; letter-spacing: .04em; }
  @media (prefers-reduced-motion: reduce) { .pxc-row line { transition: none; } }
</style>

<script is:inline>
  document.querySelectorAll('.pxc').forEach((root) => {
    if (root.dataset.bound) return; root.dataset.bound = '1';
    const items = [...root.querySelectorAll('li')];
    const tick = () => {
      const now = new Date();
      items.forEach((li) => {
        const parts = new Intl.DateTimeFormat('en-US', { timeZone: li.dataset.tz, hour: 'numeric', minute: 'numeric', hour12: false }).formatToParts(now);
        const h = +parts.find((p) => p.type === 'hour').value % 12, m = +parts.find((p) => p.type === 'minute').value;
        li.querySelector('.h').setAttribute('transform', `rotate(${h * 30 + m / 2} 50 50)`);
        li.querySelector('.m').setAttribute('transform', `rotate(${m * 6} 50 50)`);
        li.setAttribute('title', `${li.textContent.trim()} ${String(h || 12)}:${String(m).padStart(2, '0')}`);
      });
    };
    tick(); setInterval(tick, 15000);
  });
</script>
