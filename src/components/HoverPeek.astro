---
// A small tilted print that trails the cursor while it is over any element
// carrying data-peek="<image url>" (or data-peek="lock" for private work).
// Mouse only: phones and pens never see it.
---

<div class="peek" id="peek" aria-hidden="true"></div>

<script>
  const peek = document.getElementById('peek');
  if (peek && matchMedia('(hover: hover)').matches) {
    let px = 0, py = 0, tx = 0, ty = 0, raf = 0;
    const move = () => {
      px += (tx - px) * 0.22; py += (ty - py) * 0.22;
      const tilt = Math.max(-6, Math.min(6, (tx - px) * 0.08)) - 2.5;
      peek.style.transform = `translate(${px}px, ${py}px) rotate(${tilt}deg)`;
      raf = requestAnimationFrame(move);
    };
    document.querySelectorAll<HTMLElement>('[data-peek]').forEach((el) => {
      el.addEventListener('mouseenter', (e) => {
        const src = el.dataset.peek!;
        peek.innerHTML = src === 'lock'
          ? '<div class="peek-lock"><div><b>Locked</b><br>Password protected</div></div>'
          : `<img alt="" src="${src}">`;
        tx = px = e.clientX + 18; ty = py = e.clientY + 16;
        peek.classList.add('on');
        if (!raf) move();
      });
      el.addEventListener('mousemove', (e) => {
        tx = Math.min(e.clientX + 18, innerWidth - 180);
        ty = Math.min(e.clientY + 16, innerHeight - 130);
      });
      el.addEventListener('mouseleave', () => { peek.classList.remove('on'); cancelAnimationFrame(raf); raf = 0; });
    });
  }
</script>

<style>
  .peek {
    position: fixed; left: 0; top: 0; z-index: 300; width: 160px; pointer-events: none;
    opacity: 0; transform: translate(-9999px, 0); transition: opacity .2s;
    border: 1px solid var(--black); background: var(--off-white); padding: 4px;
    box-shadow: 0 18px 40px -20px rgba(0,0,0,.45);
  }
  :global(.peek.on) { opacity: 1; }
  .peek :global(img) { display: block; width: 100%; height: 100px; object-fit: cover; object-position: top; }
  .peek :global(.peek-lock) { height: 100px; display: grid; place-items: center; text-align: center; background: var(--black); color: var(--off-white); font-family: var(--font-mono); font-size: 10px; }
  .peek :global(.peek-lock b) { display: block; font-family: var(--font-black); font-weight: 400; font-size: 26px; color: var(--accent-loud); line-height: 1; text-transform: none; }
  @media (prefers-reduced-motion: reduce) { .peek { transition: none; } }
</style>
